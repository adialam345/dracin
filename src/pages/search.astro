---
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';

const query = Astro.url.searchParams.get('q') || '';
const currentProvider = Astro.url.searchParams.get('p') || 'all';

const providers = [
  { id: 'all', name: 'Semua' },
  { id: 'dramabox', name: 'Dramabox' },
  { id: 'shortmax', name: 'ShortMax' },
  { id: 'goodshort', name: 'GoodShort' },
  { id: 'dramawave', name: 'DramaWave' },
  { id: 'netshort', name: 'NetShort' },
  { id: 'melolo', name: 'Melolo' },
  { id: 'radreel', name: 'RadReel' },
  { id: 'dramaflickreels', name: 'FlickReels' },
  { id: 'dramadash', name: 'DramaDash' },
  { id: 'starshort', name: 'StarShort' },
  { id: 'freeshort', name: 'FreeShort' },
  { id: 'hishort', name: 'HiShort' },
  { id: 'dotdrama', name: 'DotDrama' },
  { id: 'stardusttv', name: 'StardustTV' },
  { id: 'reelife', name: 'ReelLife' },
  { id: 'meloshort', name: 'MeloShort' },
  { id: 'vigloo', name: 'Vigloo' },
];
---

<Layout title={query ? `Hasil pencarian: ${query} - DramaIn` : 'Cari Drama - DramaIn'}>
  {/* Ambient Background */}
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 -z-10"></div>

  <div class="container mx-auto px-4 py-12 md:py-20">
    <div class="max-w-4xl mx-auto mb-16 animate-fade-in-up">
      <h1 class="text-3xl md:text-5xl font-bold mb-8 text-center text-transparent bg-clip-text bg-gradient-to-b from-white to-zinc-500 tracking-tight">
        Cari Drama
      </h1>

      <form method="get" action="/search" class="space-y-6">
        <div class="relative group max-w-2xl mx-auto">
          <div class="absolute inset-0 bg-gradient-to-r from-red-600 to-indigo-600 rounded-2xl blur-xl opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
          <div class="relative">
            <input
              type="text"
              name="q"
              value={query}
              placeholder="Ketik judul drama..."
              class="w-full pl-6 pr-14 py-4 md:py-5 bg-zinc-900/80 backdrop-blur-xl text-white rounded-2xl border border-white/10 focus:border-red-500/50 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all duration-300 placeholder:text-zinc-600 text-lg shadow-xl"
              autofocus
              autocomplete="off"
            />
            <button
              type="submit"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl transition-all duration-300 hover:scale-105 shadow-lg shadow-red-900/20"
              aria-label="Cari"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </button>
          </div>
        </div>

        {/* Provider Filter Chips - Scrollable Horizontal */}
        <div class="relative max-w-2xl mx-auto group/scroll">
          <div class="flex items-center gap-2 overflow-x-auto pb-4 no-scrollbar scroll-smooth">
            <div class="flex items-center gap-2 px-1">
              <span class="text-zinc-500 text-[10px] uppercase tracking-widest font-bold whitespace-nowrap mr-2 border-r border-white/10 pr-3">Provider</span>
              {providers.map((p) => (
                <label class="cursor-pointer flex-shrink-0">
                  <input 
                    type="radio" 
                    name="p" 
                    value={p.id} 
                    class="hidden peer" 
                    checked={currentProvider === p.id}
                    onchange="this.form.submit()"
                  />
                  <span class="px-4 py-1.5 rounded-xl bg-zinc-900/50 border border-white/5 text-zinc-400 text-sm transition-all duration-300 peer-checked:bg-white peer-checked:text-black peer-checked:border-white hover:bg-zinc-800 whitespace-nowrap inline-block">
                    {p.name}
                  </span>
                </label>
              ))}
            </div>
          </div>
          {/* Faders for horizontal scroll indication */}
          <div class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-zinc-950 to-transparent pointer-events-none opacity-0 group-hover/scroll:opacity-100 transition-opacity"></div>
          <div class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-zinc-950 to-transparent pointer-events-none opacity-100"></div>
        </div>
      </form>
    </div>

    <style>
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    {query && (
      <div id="status-area" class="mb-8 text-center animate-fade-in-up delay-100">
         <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900 border border-zinc-800">
            <div class="w-4 h-4 border-2 border-red-500 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-zinc-400 text-sm">Sedang mencari...</span>
         </div>
      </div>
    )}

    {/* Result Grid */}
    <div id="results-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10 animate-fade-in-up delay-200">
       {/* Cards injected by JS */}
    </div>

    {/* Empty State (Hidden by default) */}
    <div id="empty-state" class="hidden text-center py-24 animate-fade-in-up">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-zinc-900/50 border border-white/5 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-600">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-semibold text-white mb-2">Tidak Ada Hasil</h2>
        <p class="text-zinc-500 mb-8 max-w-md mx-auto">
          Kami tidak dapat menemukan drama yang Anda cari. Coba kata kunci lain.
        </p>
    </div>

    {/* Guide State (If no query) */}
    {!query && (
      <div class="text-center py-24 animate-fade-in-up delay-200 opacity-60">
        <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-b from-zinc-800 to-transparent mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-500">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </div>
        <p class="text-zinc-500 text-lg">
          Ketik judul drama di atas untuk mulai mencari
        </p>
      </div>
    )}

  </div>

<script define:vars={{ query, currentProvider }}>
  // Image Error Handler (Global Fallback)
  window.handleImageError = window.handleImageError || function(img) {
    img.style.display = 'none';
    const container = img.parentElement;
    if (container) {
      container.style.background = 'linear-gradient(135deg, #18181b 0%, #27272a 100%)'; // Darker fallback
      const placeholder = document.createElement('div');
      placeholder.className = 'absolute inset-0 flex items-center justify-center';
      placeholder.innerHTML = `
        <div class="text-center p-4">
          <svg class="w-12 h-12 mx-auto mb-2 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <p class="text-[10px] text-zinc-500 line-clamp-2">${img.alt}</p>
        </div>
      `;
      container.appendChild(placeholder);
    }
  };

  if (query) {
      const grid = document.getElementById('results-grid');
      const statusArea = document.getElementById('status-area');
      const emptyState = document.getElementById('empty-state');
      let totalFound = 0;
      const seenIds = new Set();
      let searchDone = false;

      const sourceLabels = {
        dramabox: { label: 'DB', color: 'bg-red-600/90' },
        netshort: { label: 'NS', color: 'bg-blue-600/90' },
        melolo: { label: 'ML', color: 'bg-lime-600/90' },
        radreel: { label: 'RR', color: 'bg-purple-600/90' },
        dramawave: { label: 'DW', color: 'bg-orange-500/90' },
        dramaflickreels: { label: 'FR', color: 'bg-pink-600/90' },
        dramadash: { label: 'DD', color: 'bg-cyan-600/90' },
        shortmax: { label: 'SM', color: 'bg-yellow-500/90' },
        starshort: { label: 'SS', color: 'bg-emerald-600/90' },
        freeshort: { label: 'FS', color: 'bg-indigo-600/90' },
        hishort: { label: 'HS', color: 'bg-fuchsia-600/90' },
        goodshort: { label: 'GS', color: 'bg-teal-500/90' },
        dotdrama: { label: 'DTD', color: 'bg-rose-600/90' },
        stardusttv: { label: 'SD', color: 'bg-sky-500/90' },
        reelife: { label: 'RL', color: 'bg-orange-600/90' },
        meloshort: { label: 'MS', color: 'bg-rose-500/90' },
      };

      // Connect to SSE Stream
      const evtSource = new EventSource(`/api/search-stream?q=${encodeURIComponent(query)}&p=${currentProvider}`);

      evtSource.onmessage = (event) => {
          if (event.data === '[DONE]') {
              evtSource.close();
              searchDone = true;
              updateStatus();
              if (totalFound === 0) {
                  emptyState.classList.remove('hidden');
              }
              return;
          }

          try {
              const data = JSON.parse(event.data);
              const provider = data.provider;
              const results = data.results;

              if (results && results.length > 0) {
                  results.forEach(drama => {
                      const uid = drama.source + '-' + drama.id;
                      if (seenIds.has(uid)) return;
                      seenIds.add(uid);
                      totalFound++;

                      const badge = sourceLabels[drama.source] || { label: drama.source.substring(0,2).toUpperCase(), color: 'bg-zinc-600' };

                      // Insert Card HTML matching MovieCard.astro
                      const cardHtml = `
                          <a href="/movie/${drama.source}/${drama.id}" class="group block relative animate-fade-in" data-astro-prefetch>
                              <div class="relative overflow-hidden rounded-2xl bg-zinc-900/50 aspect-[2/3] transition-all duration-500 ease-out group-hover:shadow-[0_8px_30px_rgb(0,0,0,0.5)]">
                                  <img
                                      src="${drama.cover}"
                                      alt="${drama.title}"
                                      loading="lazy"
                                      class="w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-110 opacity-0"
                                      onload="this.classList.remove('opacity-0')"
                                      onerror="handleImageError(this)"
                                  />
                                  
                                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                                  
                                  <!-- Source Badge -->
                                  <div class="absolute top-2 right-2 px-2 py-0.5 rounded text-[10px] font-bold text-white uppercase backdrop-blur-sm ${badge.color}">
                                      ${badge.label}
                                  </div>

                                  <!-- Play Icon Overlay -->
                                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 scale-90 group-hover:scale-100">
                                      <div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white shadow-lg">
                                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white" stroke="currentColor" stroke-width="0" stroke-linecap="round" stroke-linejoin="round">
                                              <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                          </svg>
                                      </div>
                                  </div>

                                  <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
                                      <h3 class="font-medium text-white text-base leading-tight line-clamp-2 mb-1 group-hover:text-red-400 transition-colors duration-300">
                                          ${drama.title}
                                      </h3>
                                      <p class="text-xs text-zinc-400 line-clamp-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                                          ${drama.description || ''}
                                      </p>
                                  </div>
                              </div>
                          </a>
                      `;
                      // Append as HTML
                      grid.insertAdjacentHTML('beforeend', cardHtml);
                  });
                  updateStatus();
              }
          } catch(e) {
              console.error('Parse error', e);
          }
      };

      evtSource.onerror = () => {
          evtSource.close();
          // If error happens before DONE and no results, show empty
          if (!searchDone && totalFound === 0) {
               searchDone = true;
               updateStatus();
               if (totalFound === 0) emptyState.classList.remove('hidden');
          }
      };

      function updateStatus() {
          if (searchDone) {
             statusArea.innerHTML = `
                <p class="text-zinc-400 text-lg">
                  Ditemukan <span class="text-white font-semibold">${totalFound}</span> drama untuk "<span class="text-white italic">${query}</span>"
                </p>
             `;
          } else {
             statusArea.innerHTML = `
                 <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900 border border-zinc-800">
                    <div class="w-4 h-4 border-2 border-red-500 border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-zinc-400 text-sm">Mencari... (${totalFound} ditemukan)</span>
                 </div>
             `;
          }
      }
  }
</script>
