---
import { fetchAggregatedHome } from '../../services/aggregator';
import MovieCard from '../../components/MovieCard.astro';

export const partial = true;

const { forYou, trending, latest } = await fetchAggregatedHome();

// Enable Cloudflare edge caching for the partial feed
// Cache for 2 hours (7200s)
Astro.response.headers.set('Cache-Control', 'public, max-age=7200, s-maxage=7200');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'max-age=7200');
---

<div id="deferred-results">
    {forYou.length > 0 && (
      <div id="section-foryou-content" hx-swap-oob="beforeend">
          {forYou.map((drama: any) => (
             <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} />
          ))}
      </div>
    )}

    {trending.length > 0 && (
      <div id="section-trending-content" hx-swap-oob="beforeend">
          {trending.map((drama: any) => (
             <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} />
          ))}
      </div>
    )}

    {latest.length > 0 && (
      <div id="section-latest-content" hx-swap-oob="beforeend">
          {latest.map((drama: any) => (
             <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} />
          ))}
      </div>
    )}
</div>
