---
import '../../styles/global.css';
import { validateSession } from '../../lib/admin';

// Server Side Protection
const sessionCookie = Astro.cookies.get('admin_session');
if (!sessionCookie || !validateSession(sessionCookie.value)) {
  return Astro.redirect('/admin/login');
}
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>Admin Dashboard - DramaIn</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      .stat-card {
        background: linear-gradient(135deg, rgba(39, 39, 42, 0.8) 0%, rgba(24, 24, 27, 0.9) 100%);
        backdrop-filter: blur(20px);
      }
      
      .glow-red { box-shadow: 0 0 40px rgba(239, 68, 68, 0.15); }
      .glow-blue { box-shadow: 0 0 40px rgba(59, 130, 246, 0.15); }
      .glow-green { box-shadow: 0 0 40px rgba(34, 197, 94, 0.15); }
      .glow-purple { box-shadow: 0 0 40px rgba(168, 85, 247, 0.15); }
      
      .table-row:hover {
        background: rgba(255, 255, 255, 0.03);
      }
      
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.8); }
      }
      
      .pulse-dot {
        animation: pulse-dot 2s ease-in-out infinite;
      }
      
      .source-badge {
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
        text-transform: uppercase;
      }
      
      .source-dramabox { background: rgba(239, 68, 68, 0.2); color: #f87171; }
      .source-netshort { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
      .source-shortmax { background: rgba(168, 85, 247, 0.2); color: #c084fc; }
      .source-dramadash { background: rgba(34, 197, 94, 0.2); color: #4ade80; }
      .source-hishort { background: rgba(251, 146, 60, 0.2); color: #fb923c; }
      .source-freeshort { background: rgba(236, 72, 153, 0.2); color: #f472b6; }
      .source-default { background: rgba(161, 161, 170, 0.2); color: #a1a1aa; }
    </style>
  </head>
  <body class="min-h-screen bg-zinc-950 font-sans text-white">
    <!-- Animated Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none opacity-50">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-br from-red-500/10 to-orange-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-blue-500/10 to-purple-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="fixed inset-0 bg-zinc-950/90 backdrop-blur-sm z-50 flex items-center justify-center">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 mb-4">
          <svg class="animate-spin w-12 h-12 text-red-500" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <p class="text-zinc-400">Memuat dashboard...</p>
      </div>
    </div>

    <div class="relative z-10 min-h-screen">
      <!-- Header -->
      <header class="sticky top-0 z-40 backdrop-blur-xl bg-zinc-950/80 border-b border-zinc-800/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-gradient-to-br from-red-500 to-orange-500 rounded-xl flex items-center justify-center shadow-lg shadow-red-500/20">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <div>
                <h1 class="font-bold text-lg">Admin Dashboard</h1>
                <p class="text-xs text-zinc-500">DramaIn Analytics</p>
              </div>
            </div>

            <!-- Header Actions -->
            <div class="flex items-center gap-4">
              <!-- Live Indicator -->
              <div class="flex items-center gap-2 px-3 py-1.5 bg-green-500/10 border border-green-500/30 rounded-full">
                <span class="w-2 h-2 bg-green-500 rounded-full pulse-dot"></span>
                <span class="text-green-400 text-sm font-medium">Live</span>
              </div>
              
              <!-- Refresh Button -->
              <button
                id="refreshBtn"
                class="p-2 hover:bg-zinc-800 rounded-lg transition-colors"
                title="Refresh Data"
              >
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
              </button>

              <!-- Logout Button -->
              <button
                id="logoutBtn"
                class="flex items-center gap-2 px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-colors text-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Logout
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <!-- Total Visits -->
          <div class="stat-card glow-blue rounded-2xl p-6 border border-zinc-800/50">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </div>
              <span class="text-xs text-zinc-500">Sejak server start</span>
            </div>
            <div>
              <p class="text-3xl font-bold" id="totalVisits">-</p>
              <p class="text-sm text-zinc-400">Total Kunjungan</p>
            </div>
          </div>

          <!-- Active Users -->
          <div class="stat-card glow-green rounded-2xl p-6 border border-zinc-800/50">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-green-500/10 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <span class="flex items-center gap-1 text-xs text-green-400">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full pulse-dot"></span>
                Real-time
              </span>
            </div>
            <div>
              <p class="text-3xl font-bold" id="activeUsers">-</p>
              <p class="text-sm text-zinc-400">User Aktif</p>
            </div>
          </div>

          <!-- Users Watching -->
          <div class="stat-card glow-red rounded-2xl p-6 border border-zinc-800/50">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-red-500/10 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <span class="text-xs text-zinc-500">Sedang menonton</span>
            </div>
            <div>
              <p class="text-3xl font-bold" id="watchingUsers">-</p>
              <p class="text-sm text-zinc-400">Menonton Drama</p>
            </div>
          </div>


        </div>

        <!-- Active Users Table -->
        <div class="stat-card rounded-2xl border border-zinc-800/50 overflow-hidden">
          <div class="p-6 border-b border-zinc-800/50">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-semibold flex items-center gap-2">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                User Aktif Sekarang
              </h2>
              <span id="lastUpdate" class="text-xs text-zinc-500">Terakhir update: -</span>
            </div>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="text-left text-xs text-zinc-500 border-b border-zinc-800/50">
                  <th class="p-4 font-medium">User</th>
                  <th class="p-4 font-medium">Halaman</th>
                  <th class="p-4 font-medium">Drama</th>
                  <th class="p-4 font-medium">Waktu</th>
                </tr>
              </thead>
              <tbody id="activeUsersTable">
                <tr>
                  <td colspan="4" class="p-8 text-center text-zinc-500">
                    <svg class="animate-spin w-6 h-6 mx-auto mb-2" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Memuat data...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Error Reports Section -->
        <div class="mt-8 stat-card rounded-2xl border border-orange-800/50 overflow-hidden">
          <div class="p-6 border-b border-orange-800/50">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-semibold flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                Laporan Error
                <span id="errorCount" class="ml-2 px-2 py-0.5 text-xs bg-orange-500/20 text-orange-400 rounded-full">0</span>
              </h2>
              <button
                id="clearAllErrorsBtn"
                class="px-3 py-1.5 text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors"
              >
                Hapus Semua
              </button>
            </div>
          </div>
          
          <div class="p-4 space-y-3 max-h-[400px] overflow-y-auto" id="errorReportsList">
            <div class="text-center text-zinc-500 py-8">
              <svg class="animate-spin w-6 h-6 mx-auto mb-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Memuat data...
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-sm p-6 transform scale-95 opacity-0 transition-all duration-200" id="confirmContent">
        <h3 class="text-xl font-bold mb-2">Konfirmasi</h3>
        <p class="text-zinc-400 mb-6" id="confirmMessage">Apakah Anda yakin?</p>
        <div class="flex gap-3 justify-end">
           <button id="cancelBtn" class="px-4 py-2 rounded-lg text-zinc-300 hover:bg-zinc-800 transition-colors">Batal</button>
           <button id="confirmBtn" class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors">Ya, Lanjutkan</button>
        </div>
      </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script>
      // Check authentication - Server side protected, but good for client redirect if session expires
      // No need for client-side check anymore as the page is protected server-side
      
      // Toast System
      function showToast(message, type = 'success') {
         const container = document.getElementById('toastContainer');
         const toast = document.createElement('div');
         
         const colors = type === 'success' ? 'bg-green-500/10 border-green-500/20 text-green-400' : 
                        type === 'error' ? 'bg-red-500/10 border-red-500/20 text-red-400' : 'bg-blue-500/10 border-blue-500/20 text-blue-400';
         
         toast.className = `max-w-xs w-full p-4 rounded-xl border backdrop-blur-md shadow-lg transform translate-y-10 opacity-0 transition-all duration-300 pointer-events-auto flex items-center gap-3 ${colors}`;
         toast.innerHTML = `
            <div class="flex-shrink-0">
               ${type === 'success' ? '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>' : 
                 type === 'error' ? '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>' :
                 '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>'}
            </div>
            <p class="text-sm font-medium">${message}</p>
         `;
         
         container.appendChild(toast);
         
         // Animate in
         requestAnimationFrame(() => {
             toast.classList.remove('translate-y-10', 'opacity-0');
         });
         
         // Remove after 3s
         setTimeout(() => {
             toast.classList.add('translate-x-full', 'opacity-0');
             setTimeout(() => toast.remove(), 300);
         }, 3000);
      }

      // Custom Confirmation Modal
      function showConfirm(message) {
         return new Promise((resolve) => {
             const modal = document.getElementById('confirmModal');
             const content = document.getElementById('confirmContent');
             const msgEl = document.getElementById('confirmMessage');
             const confirmBtn = document.getElementById('confirmBtn');
             const cancelBtn = document.getElementById('cancelBtn');
             
             msgEl.textContent = message;
             modal.classList.remove('hidden');
             modal.classList.add('flex');
             
             // Animate in
             requestAnimationFrame(() => {
                 content.classList.remove('scale-95', 'opacity-0');
                 content.classList.add('scale-100', 'opacity-100');
             });
             
             const cleanup = () => {
                 content.classList.remove('scale-100', 'opacity-100');
                 content.classList.add('scale-95', 'opacity-0');
                 setTimeout(() => {
                     modal.classList.add('hidden');
                     modal.classList.remove('flex');
                 }, 200);
                 
                 confirmBtn.replaceWith(confirmBtn.cloneNode(true));
                 cancelBtn.replaceWith(cancelBtn.cloneNode(true));
             };
             
             document.getElementById('confirmBtn').onclick = () => {
                 cleanup();
                 resolve(true);
             };
             
             document.getElementById('cancelBtn').onclick = () => {
                 cleanup();
                 resolve(false);
             };
         });
      }
      
      // Helper function to format time
      function formatTimeAgo(seconds: number): string {
        if (seconds < 60) return `${seconds}d yang lalu`;
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m yang lalu`;
        const hours = Math.floor(minutes / 60);
        return `${hours}j ${minutes % 60}m`;
      }

      function formatDuration(seconds: number): string {
        if (seconds < 60) return `${seconds}s`;
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m ${seconds % 60}s`;
        const hours = Math.floor(minutes / 60);
        return `${hours}h ${minutes % 60}m`;
      }

      function getSourceBadgeClass(source: string): string {
        const lower = source?.toLowerCase() || '';
        if (lower.includes('dramabox')) return 'source-dramabox';
        if (lower.includes('netshort')) return 'source-netshort';
        if (lower.includes('shortmax')) return 'source-shortmax';
        if (lower.includes('dramadash')) return 'source-dramadash';
        if (lower.includes('hishort')) return 'source-hishort';
        if (lower.includes('freeshort')) return 'source-freeshort';
        return 'source-default';
      }

      async function fetchAnalytics() {
        try {
          const response = await fetch('/api/admin/analytics');

          if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
          }

          const data = await response.json();
          
          document.getElementById('totalVisits')!.textContent = data.totalVisits.toLocaleString();
          document.getElementById('activeUsers')!.textContent = data.activeUsersCount.toString();
          document.getElementById('watchingUsers')!.textContent = data.usersWatchingDrama.toString();
          
          // Update last update time
          const now = new Date();
          document.getElementById('lastUpdate')!.textContent = `Terakhir update: ${now.toLocaleTimeString('id-ID')}`;

          // Update active users table
          const tableBody = document.getElementById('activeUsersTable')!;
          if (data.activeUsers.length === 0) {
            tableBody.innerHTML = `
              <tr>
                <td colspan="4" class="p-8 text-center text-zinc-500">
                  <svg class="w-12 h-12 mx-auto mb-3 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <p>Belum ada user aktif</p>
                </td>
              </tr>
            `;
          } else {
            tableBody.innerHTML = data.activeUsers.map((user: any) => `
              <tr class="table-row border-b border-zinc-800/30 transition-colors">
                <td class="p-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-gradient-to-br from-zinc-700 to-zinc-800 rounded-full flex items-center justify-center text-xs font-medium">
                      ${user.sessionId.substring(0, 2).toUpperCase()}
                    </div>
                    <div>
                      <p class="text-sm font-medium text-zinc-200">${user.sessionId.substring(0, 8)}...</p>
                      <p class="text-xs text-zinc-500">${user.ip}</p>
                    </div>
                  </div>
                </td>
                <td class="p-4">
                  <span class="text-sm text-zinc-300">${user.currentPage}</span>
                </td>
                <td class="p-4">
                  ${user.isWatchingDrama ? `
                    <div>
                      <p class="text-sm text-zinc-200 line-clamp-1">${user.dramaTitle}</p>
                      <div class="flex items-center gap-2 mt-1">
                        <span class="source-badge ${getSourceBadgeClass(user.dramaSource)}">${user.dramaSource}</span>
                        ${user.episodeNumber ? `<span class="text-xs text-zinc-500">EP ${user.episodeNumber}</span>` : ''}
                      </div>
                    </div>
                  ` : `
                    <span class="text-sm text-zinc-500">-</span>
                  `}
                </td>
                <td class="p-4">
                  <div class="flex items-center gap-2">
                      <span class="text-sm text-zinc-400">${formatDuration(user.timeOnSite)}</span>
                      <button 
                         onclick="kickUser('${user.sessionId}')"
                         class="p-1.5 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors ml-auto group relative"
                         title="Kick User"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span class="absolute right-full top-1/2 -translate-y-1/2 text-[10px] bg-red-600 text-white px-2 py-0.5 rounded mr-2 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">Kick</span>
                      </button>
                  </div>
                </td>
              </tr>
            `).join('');
          }

          // Define kick function
          (window as any).kickUser = async (sessionId: string) => {
             if(!confirm('Keluarkan user ini secara paksa? Mereka akan dibanned sementara.')) return;
             try {
                await fetch('/api/admin/analytics', {
                   method: 'POST',
                   headers: { 'Content-Type': 'application/json' },
                   body: JSON.stringify({ action: 'kick', targetSessionId: sessionId })
                });
                // Refresh list
                fetchAnalytics();
             } catch(e) {
                alert('Gagal kick user');
                console.error(e);
             }
          };


          // Hide loading overlay
          document.getElementById('loadingOverlay')?.classList.add('hidden');

        } catch (error) {
          console.error('Failed to fetch analytics:', error);
          // showToast('Gagal memuat data analytics', 'error'); // Avoid loop
        }
      }

      // Initial fetch
      fetchAnalytics();

      // Auto-refresh every 5 seconds
      setInterval(fetchAnalytics, 5000);

      // Manual refresh
      document.getElementById('refreshBtn')?.addEventListener('click', () => {
        const btn = document.getElementById('refreshBtn');
        btn?.classList.add('animate-spin');
        fetchAnalytics().then(() => {
          setTimeout(() => btn?.classList.remove('animate-spin'), 500);
          showToast('Data berhasil diperbarui');
        });
      });

      // Logout
      document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        if(await showConfirm('Apakah Anda yakin ingin keluar?')) {
            await fetch('/api/admin/login', { method: 'DELETE' });
            window.location.href = '/admin/login';
        }
      });

      // Error Reports Functions
      function formatErrorTime(timestamp: number): string {
        const now = Date.now();
        const diff = Math.floor((now - timestamp) / 1000);
        
        if (diff < 60) return `${diff} detik lalu`;
        if (diff < 3600) return `${Math.floor(diff / 60)} menit lalu`;
        if (diff < 86400) return `${Math.floor(diff / 3600)} jam lalu`;
        return `${Math.floor(diff / 86400)} hari lalu`;
      }

      async function fetchErrorReports() {
        try {
          const response = await fetch('/api/admin/error-reports');

          if (response.status === 401) return;

          const data = await response.json();
          
          // Update error count badge
          const countBadge = document.getElementById('errorCount');
          if (countBadge) {
            countBadge.textContent = data.unresolvedCount.toString();
            if (data.unresolvedCount > 0) {
              countBadge.classList.add('animate-pulse');
            } else {
              countBadge.classList.remove('animate-pulse');
            }
          }

          // Update error reports list
          const reportsList = document.getElementById('errorReportsList');
          if (!reportsList) return;

          if (data.reports.length === 0) {
            reportsList.innerHTML = `
              <div class="text-center text-zinc-500 py-8">
                <svg class="w-12 h-12 mx-auto mb-3 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <p>Tidak ada laporan error</p>
              </div>
            `;
          } else {
            reportsList.innerHTML = data.reports.map((report: any) => `
              <div class="flex items-start gap-3 p-4 rounded-xl ${report.resolved ? 'bg-zinc-800/20 opacity-60' : 'bg-orange-500/5 border border-orange-500/20'} transition-all">
                <div class="flex-shrink-0 mt-1">
                  ${report.resolved 
                    ? `<svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>`
                    : `<svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                      </svg>`
                  }
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-zinc-200 break-all mb-1">${report.url}</p>
                  <div class="flex items-center gap-3 text-xs text-zinc-500">
                    <span>IP: ${report.ip}</span>
                    <span>•</span>
                    <span>${formatErrorTime(report.timestamp)}</span>
                  </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <a 
                    href="${report.url}" 
                    target="_blank"
                    class="p-2 hover:bg-blue-500/20 text-blue-400 rounded-lg transition-colors"
                    title="Buka halaman"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                  ${!report.resolved ? `
                    <button 
                      onclick="handleErrorAction('${report.id}', 'resolve')"
                      class="p-2 hover:bg-green-500/20 text-green-400 rounded-lg transition-colors"
                      title="Tandai selesai"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </button>
                  ` : ''}
                  <button 
                    onclick="handleErrorAction('${report.id}', 'delete')"
                    class="p-2 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors"
                    title="Hapus"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                </div>
              </div>
            `).join('');
          }
        } catch (error) {
          console.error('Failed to fetch error reports:', error);
        }
      }

      // Handle error report actions
      (window as any).handleErrorAction = async (id: string, action: string) => {
        try {
          await fetch('/api/admin/error-reports', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ id, action })
          });
          fetchErrorReports();
          showToast(action === 'delete' ? 'Laporan dihapus' : 'Laporan diselesaikan');
        } catch (error) {
          console.error('Failed to handle error action:', error);
          showToast('Gagal memproses aksi', 'error');
        }
      };

      // Clear all errors
      document.getElementById('clearAllErrorsBtn')?.addEventListener('click', async () => {
        if (await showConfirm('Hapus semua laporan error?')) {
          try {
            await fetch('/api/admin/error-reports', {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ action: 'clear-all' })
            });
            fetchErrorReports();
            showToast('Semua laporan telah dihapus');
          } catch (error) {
            console.error('Failed to clear errors:', error);
            showToast('Gagal menghapus laporan', 'error');
          }
        }
      });
      
      // Override kickUser with toast/confirm
      (window as any).kickUser = async (sessionId: string) => {
         // Custom confirm
         if(!await showConfirm('Keluarkan user ini secara paksa? Mereka akan dibanned sementara.')) return;
         
         try {
            const res = await fetch('/api/admin/analytics', {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ action: 'kick', targetSessionId: sessionId })
            });
            if(res.ok) {
                // Refresh list
                fetchAnalytics();
                showToast('User berhasil dikick', 'error');
            } else {
                throw new Error('API Error');
            }
         } catch(e) {
            showToast('Gagal kick user', 'error');
            console.error(e);
         }
      };

      // Initial fetch for error reports
      fetchErrorReports();

      // Auto-refresh error reports every 10 seconds
      setInterval(fetchErrorReports, 10000);
    </script>
  </body>
</html>
