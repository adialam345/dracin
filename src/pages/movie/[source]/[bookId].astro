---
import Layout from '../../../layouts/Layout.astro';
import EpisodeList from '../../../components/EpisodeList.astro';
import { fetchUnifiedDramaData } from '../../../services/aggregator';

const { source, bookId } = Astro.params;

const { drama, episodes } = await fetchUnifiedDramaData(source!, bookId!);

if (!drama) {
  return new Response("Drama not found or API error. Please try again later.", { status: 404 });
}

const movieSchema = {
  "@context": "https://schema.org",
  "@type": "Movie",
  "name": drama.title,
  "description": drama.description,
  "image": drama.cover,
  "genre": drama.labels || [],
  "numberOfEpisodes": episodes.length,
  "actor": (drama.performerList || []).map((p: any) => ({
    "@type": "Person",
    "name": p.performerName
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://nontonin.site"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": drama.title,
    "item": `https://nontonin.site/movie/${source}/${bookId}`
  }]
};
---

<Layout title={`${drama.title} Sub Indo Gratis - DramaIn`} description={drama.description} image={drama.cover}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(movieSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <div class="container mx-auto px-4 py-6 md:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
      
      {/* Mobile: Compact horizontal layout */}
      <div class="lg:hidden">
        <div class="flex gap-4">
          {/* Smaller cover on mobile */}
          <div class="flex-shrink-0 w-32 sm:w-40">
            <div class="rounded-xl overflow-hidden shadow-xl">
              <img
                src={drama.cover}
                alt={drama.title}
                class="w-full aspect-[2/3] object-cover"
                fetchpriority="high"
                loading="eager"
              />
            </div>
          </div>
          
          {/* Title and CTA on the right */}
          <div class="flex-1 flex flex-col justify-between py-1">
            <div>
              <h1 class="text-xl sm:text-2xl font-bold text-white mb-2 line-clamp-3">
                {drama.title}
              </h1>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                {drama.chapterCount && (
                  <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded-full text-xs">
                    {drama.chapterCount} Episode
                  </span>
                )}
              </div>
            </div>
            
            {episodes.length > 0 && (
              <a
                href={`/watch/${source}/${bookId}/${episodes[0].id}`}
                class="flex items-center justify-center gap-2 bg-red-500 hover:bg-red-600 text-white font-semibold px-4 py-3 rounded-lg transition-colors duration-300 text-sm"
                data-astro-prefetch
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                Mulai Menonton
              </a>
            )}
          </div>
        </div>
      </div>
      
      {/* Desktop: Original sidebar layout */}
      <div class="hidden lg:block lg:col-span-1">
        <div class="sticky top-24">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <img
              src={drama.cover}
              alt={drama.title}
              class="w-full aspect-[2/3] object-cover"
              fetchpriority="high"
              loading="eager"
            />
          </div>

          {episodes.length > 0 && (
            <a
              href={`/watch/${source}/${bookId}/${episodes[0].id}`}
              class="mt-6 w-full flex items-center justify-center gap-2 bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-4 rounded-lg transition-colors duration-300"
              data-astro-prefetch
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              Mulai Menonton
            </a>
          )}
        </div>
      </div>

      <div class="lg:col-span-2" data-drama-title={drama.title} data-drama-source={source}>
        {/* Title - Hidden on mobile (shown in compact header) */}
        <h1 class="hidden lg:block text-3xl md:text-4xl font-bold text-white mb-4">
          {drama.title}
        </h1>

        {/* Episode count and views - Hidden on mobile */}
        <div class="hidden lg:flex flex-wrap items-center gap-4 mb-6">
          {drama.chapterCount && (
            <span class="px-3 py-1 bg-zinc-800 text-zinc-300 rounded-full text-sm">
              {drama.chapterCount} Episode
            </span>
          )}
          {drama.viewCount && (
            <span class="text-zinc-400 text-sm">
              {drama.viewCount.toLocaleString()} tayangan
            </span>
          )}
        </div>

        {drama.labels && drama.labels.length > 0 && (
          <div class="mb-6">
            <div class="flex flex-wrap gap-2">
              {drama.labels.map((label: string) => (
                <span class="px-4 py-2 bg-zinc-900 text-zinc-300 rounded-lg text-sm">
                  {label}
                </span>
              ))}
            </div>
          </div>
        )}

        {drama.description && (
          <div class="mb-8">
            <h2 class="text-xl font-bold text-white mb-3">Sinopsis</h2>
            <p class="text-zinc-300 leading-relaxed">
              {drama.description}
            </p>
          </div>
        )}

        {drama.performerList && drama.performerList.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-bold text-white mb-3">Pemain</h2>
            <div class="flex flex-wrap gap-2">
              {drama.performerList.map((performer: any) => (
                <span class="px-4 py-2 bg-zinc-900 text-zinc-300 rounded-lg text-sm">
                  {performer.performerName}
                </span>
              ))}
            </div>
          </div>
        )}

        {episodes.length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-white mb-4">
              Episode ({episodes.length})
            </h2>
            <EpisodeList episodes={episodes} bookId={bookId!} source={source!} />
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
