---
import { fetchAggregatedHome } from '../services/aggregator';
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import ProviderMarquee from '../components/ProviderMarquee.astro';
import InfoPopup from '../components/InfoPopup.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

// Fetch Aggregated Data
const { forYou, trending, latest } = await fetchAggregatedHome();

const forYouDramas = forYou;
const trendingDramas = trending;
const latestDramas = latest;

// Fetch Latest Update
let latestUpdate = null;
try {
  const data = await fs.readFile(path.join(process.cwd(), 'public/data/updates.json'), 'utf-8');
  const updates = JSON.parse(data);
  if (updates.length > 0) {
    latestUpdate = updates[0];
  }
} catch (e) {
  // Ignore
}
---

<Layout title="DramaIn - Tonton Drama & Film Terbaik">
  <InfoPopup latestUpdate={latestUpdate} />
  {/* Ambient Background */}
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 -z-10"></div>

  <div class="container mx-auto px-4 py-12 md:py-20">
    
    {/* Clean Hero Section */}
    <section class="mb-12 text-center max-w-5xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 text-transparent bg-clip-text bg-gradient-to-b from-white to-zinc-500 tracking-tight animate-fade-in-up">
        DramaIn: Nonton Dracin & Drama Sub Indo
      </h1>
      <p class="text-xl md:text-2xl text-zinc-400 mb-5 font-light leading-relaxed animate-fade-in-up delay-100">
        Akses semua drama dari <span class="text-white font-semibold">17 Platform</span> dalam satu website.<br />
        Unlock semua episode. <span class="text-white font-semibold">GRATIS</span>.
      </p>

      <div class="mb-6 animate-fade-in-up delay-150 relative">
        <ProviderMarquee />
      </div>

      {/* Search Bar & Tags */}
      <div class="flex flex-col items-center gap-8 animate-fade-in-up delay-200">
        <button data-open-search class="group relative inline-flex items-center gap-3 bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-full transition-all duration-300 border border-white/10 hover:border-white/20 hover:scale-105 active:scale-95 shadow-xl shadow-black/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-white transition-colors">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="font-medium">Mulai Mencari</span>
        </button>
      </div>
    </section>

    {/* Sections */}
    <div class="space-y-16">
      {forYouDramas.length > 0 && (
        <section class="opacity-0 animate-fade-in-up delay-300 fill-mode-forwards">
          <div class="flex items-end justify-between mb-8 px-2">
            <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
              Rekomendasi Untuk Kamu
            </h2>
            <div class="h-1 w-20 bg-gradient-to-r from-red-600 to-transparent rounded-full mb-1.5"></div>
          </div>
          
          <div id="section-foryou-content" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
            {forYouDramas.map((drama: any, index: number) => (
              <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} fetchpriority={index < 2 ? 'high' : 'auto'} />
            ))}
          </div>
        </section>
      )}

      {trendingDramas.length > 0 && (
        <section class="opacity-0 animate-fade-in-up delay-[400ms] fill-mode-forwards">
          <div class="flex items-end justify-between mb-8 px-2">
            <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
              Sedang Populer
            </h2>
            <div class="h-1 w-20 bg-gradient-to-r from-orange-500 to-transparent rounded-full mb-1.5"></div>
          </div>
          
          <div id="section-trending-content" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
            {trendingDramas.map((drama: any) => (
              <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} />
            ))}
          </div>
        </section>
      )}

      {latestDramas.length > 0 && (
        <section class="opacity-0 animate-fade-in-up delay-[500ms] fill-mode-forwards">
          <div class="flex items-end justify-between mb-8 px-2">
            <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
              Rilis Terbaru
            </h2>
            <div class="h-1 w-20 bg-gradient-to-r from-blue-500 to-transparent rounded-full mb-1.5"></div>
          </div>
          
          <div id="section-latest-content" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
            {latestDramas.map((drama: any) => (
              <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} />
            ))}
          </div>
        </section>
      )}

      {forYouDramas.length === 0 && trendingDramas.length === 0 && latestDramas.length === 0 && (
        <div class="text-center py-20 bg-zinc-900/40 rounded-3xl border border-white/5 backdrop-blur-sm">
           <div id="initial-loader" class="mb-4">
               <div class="w-8 h-8 border-2 border-white/20 border-t-white rounded-full animate-spin mx-auto"></div>
               <p class="text-zinc-500 mt-2 text-sm">Sedang mencoba memuat konten lainnya...</p>
           </div>
           <p class="text-zinc-400 mb-6 hidden" id="error-msg">Gagal memuat data drama. Silakan coba segarkan halaman.</p>
           <button onclick="window.location.reload()" class="px-8 py-3 bg-white text-black font-bold rounded-full hover:bg-zinc-200 transition-colors hidden" id="refresh-btn">
             Segarkan
           </button>
        </div>
      )}
      {/* Content Section for SEO */}
      <div class="mt-20 pt-12 border-t border-white/5 space-y-12">
        <section class="max-w-4xl">
          <h2 class="text-3xl font-bold text-white mb-6">Pusat Nonton Dracin (Drama China) Terbaik</h2>
          <p class="text-zinc-400 leading-relaxed">
            DramaIn adalah tempat terbaik untuk <strong>nonton dracin</strong> favorit Anda. Kami menyatukan seluruh konten drama dari lebih dari 15 penyedia streaming ternama. Nikmati kemudahan <strong>nonton judul drama</strong> pilihan Anda dengan subtitle Indonesia yang akurat, mulai dari <strong>dracin</strong> romantis, kolosal, hingga film pendek modern.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
            <div class="space-y-3">
              <h3 class="text-xl font-semibold text-white">Kenapa Nonton Dracin di Sini?</h3>
              <ul class="text-zinc-400 space-y-2 list-disc list-inside">
                <li>Koleksi <strong>dracin</strong> paling lengkap dan selalu update.</li>
                <li>Streaming lancar untuk semua judul drama favorit.</li>
                <li>Tersedia subtitle Bahasa Indonesia untuk kenyamanan menonton.</li>
                <li>Akses gratis ke ribuan episode drama populer.</li>
              </ul>
            </div>
            <div class="space-y-3">
              <h3 class="text-xl font-semibold text-white">Streaming Dracin Tanpa Batas</h3>
              <p class="text-zinc-400">
                Temukan konten eksklusif dan <strong>nonton dracin</strong> dari Dramabox, ShortMax, NetShort, RadReel, dan lainnya. Gunakan fitur pencarian untuk langsung <strong>nonton judul drama</strong> yang Anda cari dalam sekejap.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>


<script>
  // Deferred Loading Logic
  window.addEventListener('load', async () => {
    // Only refresh if we have very little content
    const contentArea = document.getElementById('section-foryou-content');
    if (contentArea && contentArea.children.length >= 10) {
       console.log('[Home] Content already loaded, skipping background refresh.');
       return;
    }
    
    console.log('[Home] Starting background content refresh...');
    
    try {
       const res = await fetch('/partials/home-feed');
       if (!res.ok) throw new Error('Fetch failed');
       
       const html = await res.text();
       const parser = new DOMParser();
       const doc = parser.parseFromString(html, 'text/html');
       
       // Helper to update section
       const updateSection = (id) => {
          const newContent = doc.getElementById(id);
          const currentContent = document.getElementById(id);
          
          if (newContent && currentContent) {
              // Simple heuristic: If new content has MORE children, replace.
              // Or just replace always to ensure we have the "complete" set including slow providers
              if (newContent.children.length >= currentContent.children.length) {
                 console.log(`[Home] Updating ${id} with ${newContent.children.length} items (was ${currentContent.children.length})`);
                 currentContent.innerHTML = newContent.innerHTML;
              }
          } else if (newContent && !currentContent) {
             // Section didn't exist? (Should not happen with current layout structure unless empty hidden)
          }
       };

       updateSection('section-foryou-content');
       updateSection('section-trending-content');
       updateSection('section-latest-content');
       
       // Hide loader if present
       const loader = document.getElementById('initial-loader');
       if (loader) loader.style.display = 'none';
       
    } catch (e) {
       console.error('[Home] Background refresh failed:', e);
       const loader = document.getElementById('initial-loader');
       if (loader) {
           loader.style.display = 'none';
           document.getElementById('error-msg').classList.remove('hidden');
           document.getElementById('refresh-btn').classList.remove('hidden');
       }
    }
  });
</script>
</Layout>
