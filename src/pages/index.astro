---
import { fetchAggregatedHome } from '../services/aggregator';
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import ProviderMarquee from '../components/ProviderMarquee.astro';
import InfoPopup from '../components/InfoPopup.astro';
import SkeletonGrid from '../components/SkeletonGrid.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

// Fetch Aggregated Data
const { forYou, trending, latest } = await fetchAggregatedHome();

const forYouDramas = forYou;
const trendingDramas = trending;
const latestDramas = latest;

// Fetch Latest Update
let latestUpdate = null;
try {
  const data = await fs.readFile(path.join(process.cwd(), 'public/data/updates.json'), 'utf-8');
  const updates = JSON.parse(data);
  if (updates.length > 0) {
    latestUpdate = updates[0];
  }
} catch (e) {
  // Ignore
}
---

<Layout title="DramaIn - Nonton Dracin & Drama Asia Gratis Sub Indo">
  <InfoPopup latestUpdate={latestUpdate} />
  {/* Ambient Background */}
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 -z-10"></div>

  <div class="container mx-auto px-4 py-12 md:py-20">
    
    {/* Clean Hero Section */}
    <section class="mb-12 text-center max-w-5xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight animate-fade-in-up hero-title relative">
        <span class="hero-title-text">DramaIn</span>
        <span class="hero-shimmer" aria-hidden="true"></span>
      </h1>
      <p class="text-xl md:text-2xl text-zinc-400 mb-5 font-light leading-relaxed animate-fade-in-up delay-100">
        Akses semua drama dari <span class="text-white font-semibold">19 Platform</span> dalam satu website.<br />
        Unlock semua episode. <span class="text-white font-semibold">GRATIS</span>.
      </p>

      <div class="mb-6 animate-fade-in-up delay-150 relative">
        <ProviderMarquee />
      </div>

      {/* Search Bar & Tags */}
      <div class="flex flex-col items-center gap-8 animate-fade-in-up delay-200">
        <button data-open-search class="group relative inline-flex items-center gap-3 bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-full transition-all duration-300 border border-white/10 hover:border-white/20 hover:scale-105 active:scale-95 shadow-xl shadow-black/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-white transition-colors">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="font-medium">Mulai Mencari</span>
        </button>
      </div>
    </section>

    {/* Sections */}
    <div class="space-y-16">
      {forYouDramas.length > 0 && (
        <section class="opacity-0 animate-fade-in-up delay-200 fill-mode-forwards">
          <div class="flex items-end justify-between mb-8 px-2">
            <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
              Rekomendasi Untuk Kamu
            </h2>
            <div class="h-1 w-20 bg-gradient-to-r from-red-600 to-transparent rounded-full mb-1.5"></div>
          </div>
          
          <div id="section-foryou-content" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
            {forYouDramas.map((drama: any, index: number) => (
              <MovieCard 
                {...drama} 
                bookId={drama.id} 
                posterUrl={drama.cover} 
                loading={index < 4 ? "eager" : "lazy"}
                priority={index < 4 ? "high" : "auto"}
              />
            ))}
          </div>
        </section>
      )}

      {trendingDramas.length > 0 && (
        <section class="opacity-0 animate-fade-in-up delay-[400ms] fill-mode-forwards">
          <div class="flex items-end justify-between mb-8 px-2">
            <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
              Sedang Populer
            </h2>
            <div class="h-1 w-20 bg-gradient-to-r from-orange-500 to-transparent rounded-full mb-1.5"></div>
          </div>
          
          <div id="section-trending-content" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
            {trendingDramas.map((drama: any, index: number) => (
              <MovieCard 
                {...drama} 
                bookId={drama.id} 
                posterUrl={drama.cover} 
                loading={index < 6 ? "eager" : "lazy"}
                priority={index < 6 ? "high" : "auto"}
              />
            ))}
          </div>
        </section>
      )}

      {latestDramas.length > 0 && (
        <section class="opacity-0 animate-fade-in-up delay-[500ms] fill-mode-forwards">
          <div class="flex items-end justify-between mb-8 px-2">
            <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
              Rilis Terbaru
            </h2>
            <div class="h-1 w-20 bg-gradient-to-r from-blue-500 to-transparent rounded-full mb-1.5"></div>
          </div>
          
          <div id="section-latest-content" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
            {latestDramas.map((drama: any) => (
              <MovieCard {...drama} bookId={drama.id} posterUrl={drama.cover} />
            ))}
          </div>
        </section>
      )}

      {forYouDramas.length === 0 && trendingDramas.length === 0 && latestDramas.length === 0 && (
        <div id="skeleton-loading-state" class="space-y-16">
          {/* Skeleton Section 1 */}
          <section class="opacity-0 animate-fade-in-up delay-300 fill-mode-forwards">
            <div class="flex items-end justify-between mb-8 px-2">
              <div class="space-y-2">
                <div class="skeleton h-8 w-64 rounded-lg"></div>
              </div>
              <div class="skeleton h-1 w-20 rounded-full"></div>
            </div>
            <SkeletonGrid count={6} />
          </section>

          {/* Skeleton Section 2 */}
          <section class="opacity-0 animate-fade-in-up delay-[400ms] fill-mode-forwards">
            <div class="flex items-end justify-between mb-8 px-2">
              <div class="space-y-2">
                <div class="skeleton h-8 w-48 rounded-lg"></div>
              </div>
              <div class="skeleton h-1 w-20 rounded-full"></div>
            </div>
            <SkeletonGrid count={6} />
          </section>

          {/* Skeleton Section 3 */}
          <section class="opacity-0 animate-fade-in-up delay-[500ms] fill-mode-forwards">
            <div class="flex items-end justify-between mb-8 px-2">
              <div class="space-y-2">
                <div class="skeleton h-8 w-40 rounded-lg"></div>
              </div>
              <div class="skeleton h-1 w-20 rounded-full"></div>
            </div>
            <SkeletonGrid count={6} />
          </section>

          {/* Error State (hidden by default) */}
          <div id="error-state" class="hidden text-center py-20 bg-zinc-900/40 rounded-3xl border border-white/5 backdrop-blur-sm">
            <p class="text-zinc-400 mb-6" id="error-msg">Gagal memuat data drama. Silakan coba segarkan halaman.</p>
            <button onclick="window.location.reload()" class="px-8 py-3 bg-white text-black font-bold rounded-full hover:bg-zinc-200 transition-colors" id="refresh-btn">
              Segarkan
            </button>
          </div>
        </div>
      )}
    </div>
  </div>

<script>
  // Home Content Persistence Logic
  const initHome = async () => {
    if (window.location.pathname !== '/') return;
    
    const getSections = () => ({
      'section-foryou-content': document.getElementById('section-foryou-content'),
      'section-trending-content': document.getElementById('section-trending-content'),
      'section-latest-content': document.getElementById('section-latest-content')
    });
    
    let sections = getSections();
    const loader = document.getElementById('initial-loader');
    
    // Helper to determine if we ALREADY have enough content in DOM
    const hasEnoughContent = () => {
      const counts = Object.values(sections).map(el => el ? el.children.length : 0);
      return counts.some(c => c >= 5); // Heuristic: if any section has 5+ items, it's "populated"
    };

    // 1. Try to restore from session storage
    const cachedHTML = sessionStorage.getItem('home_feed_cache');
    const cacheTime = sessionStorage.getItem('home_feed_time');
    // Cache is considered fresh for 2 hours
    const isCacheFresh = cacheTime && (Date.now() - parseInt(cacheTime) < 120 * 60 * 1000); 
    
    if (cachedHTML) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(cachedHTML, 'text/html');
      
      let restoredCount = 0;
      Object.keys(sections).forEach(id => {
        const newContent = doc.getElementById(id);
        const currentContent = sections[id];
        
        // ONLY restore if DOM is empty OR cache has significantly more items (avoid flicker if same)
        if (newContent && newContent.children.length > 0) {
           if (!currentContent || currentContent.children.length < newContent.children.length) {
              // If container is missing (server returned 0), we might need to refresh full page or wait for partial
              // But if it's there, update it.
              if (currentContent) {
                requestAnimationFrame(() => {
                  currentContent.innerHTML = newContent.innerHTML;
                });
                restoredCount++;
              }
           }
        }
      });
      
      if (restoredCount > 0 && loader) {
        loader.style.display = 'none';
      }

      // If we already have content (from server or now from cache) and cache is fresh, stop here.
      if (hasEnoughContent() && isCacheFresh) {
        if (loader) loader.style.display = 'none';
        return;
      }
    }

    // 2. Background Refresh (ONLY if absolutely empty)
    if (hasEnoughContent()) {
       console.log('[Home] Content already present, skipping background fetch to maintain stability.');
       if (loader) loader.style.display = 'none';
       return;
    }

    console.log('[Home] Sections empty, fetching content...');
    try {
       const res = await fetch('/partials/home-feed');
       if (!res.ok) throw new Error('Fetch failed');
       const html = await res.text();
       const parser = new DOMParser();
       const doc = parser.parseFromString(html, 'text/html');
       
       sections = getSections();
       Object.keys(sections).forEach(id => {
          const newContent = doc.getElementById(id);
          const currentContent = sections[id];
          if (newContent && currentContent && newContent.children.length > 0) {
              requestAnimationFrame(() => {
                currentContent.innerHTML = newContent!.innerHTML;
              });
          }
       });

       sessionStorage.setItem('home_feed_cache', html);
       sessionStorage.setItem('home_feed_time', Date.now().toString());
       if (loader) loader.style.display = 'none';
    } catch (e) {
       console.error('[Home] Fetch failed:', e);
       // Hide skeleton and show error state
       const skeletonState = document.getElementById('skeleton-loading-state');
       const errorState = document.getElementById('error-state');
       if (skeletonState && errorState) {
         skeletonState.innerHTML = '';
         skeletonState.appendChild(errorState);
         errorState.classList.remove('hidden');
       }
    }
  };

  // Run on every View Transition navigation (including initial load)
  document.addEventListener('astro:page-load', initHome);
</script>

<style>
  .hero-title {
    display: inline-block;
    position: relative;
  }

  .hero-title-text {
    display: inline-block;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #e4e4e7 25%,
      #a1a1aa 50%,
      #71717a 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5))
            drop-shadow(0 8px 25px rgba(0, 0, 0, 0.3));
  }

  .hero-shimmer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 35%,
      rgba(255, 255, 255, 0.15) 40%,
      rgba(255, 255, 255, 0.5) 45%,
      rgba(255, 255, 255, 0.9) 48%,
      #ffffff 50%,
      rgba(255, 255, 255, 0.9) 52%,
      rgba(255, 255, 255, 0.5) 55%,
      rgba(255, 255, 255, 0.15) 60%,
      transparent 65%,
      transparent 100%
    );
    background-size: 250% 100%;
    animation: shimmer3D 6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    pointer-events: none;
    z-index: 2;
    /* Clip shimmer to the text shape */
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .hero-shimmer::before {
    content: 'DramaIn';
  }

  @keyframes shimmer3D {
    0% {
      background-position: 150% center;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      background-position: -150% center;
      opacity: 0;
    }
  }

  /* Subtle ambient glow behind the title */
  .hero-title::before {
    content: 'DramaIn';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #a1a1aa 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: blur(35px);
    opacity: 0.4;
    z-index: 0;
    animation: glowPulse 5s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.02);
    }
  }
</style>
</Layout>
