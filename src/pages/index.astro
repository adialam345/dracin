---
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';

const API_BASE = 'https://api.sansekai.my.id/api';

async function fetchDramas(endpoint: string) {
  try {
    const response = await fetch(`${API_BASE}${endpoint}`);
    if (!response.ok) return [];
    const data = await response.json();

    // Handle direct array response (e.g., trending, random)
    if (Array.isArray(data)) {
      return data;
    }

    // Handle nested data property (common in some APIs)
    if (data.data && Array.isArray(data.data)) {
      return data.data;
    }

    // Handle columnVoList structure (e.g., VIP page maybe?)
    if (data.columnVoList && Array.isArray(data.columnVoList)) {
      const allBooks: any[] = [];
      data.columnVoList.forEach((column: any) => {
        if (column.bookList && Array.isArray(column.bookList)) {
          allBooks.push(...column.bookList);
        }
      });
      return allBooks;
    }
    
    // Fallback for object with direct bookList
    if (data.bookList && Array.isArray(data.bookList)) {
      return data.bookList;
    }

    return [];
  } catch (error) {
    console.error(`Error fetching ${endpoint}:`, error);
    return [];
  }
}

const [forYouDramas, popularSearch] = await Promise.all([
  fetchDramas('/dramabox/foryou'),
  fetchDramas('/dramabox/populersearch'),
]);

// Define unused variables as empty to satisfy any lingering checks if expanding later, 
// though we will remove the sections below.
const vipDramas: any[] = [];
const latestDramas: any[] = [];
const trendingDramas: any[] = [];
const dubIndoDramas: any[] = [];
const randomDramas: any[] = [];
---

<Layout title="DramaKu - Tonton Drama & Film Terbaik">
  {/* Ambient Background */}
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 -z-10"></div>

  <div class="container mx-auto px-4 py-12 md:py-20">
    
    {/* Clean Hero Section */}
    <section class="mb-24 text-center max-w-4xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 text-transparent bg-clip-text bg-gradient-to-b from-white to-zinc-500 tracking-tight animate-fade-in-up">
        DramaKu
      </h1>
      <p class="text-xl md:text-2xl text-zinc-400 mb-10 font-light leading-relaxed animate-fade-in-up delay-100">
        Koleksi drama terbaik dengan kualitas HD. <br class="hidden md:block" />
        Tonton kapan saja, dimana saja.
      </p>

      {/* Search Bar & Tags */}
      <div class="flex flex-col items-center gap-8 animate-fade-in-up delay-200">
        <a href="/search" class="group relative inline-flex items-center gap-3 bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-full transition-all duration-300 border border-white/10 hover:border-white/20 hover:scale-105 active:scale-95 shadow-xl shadow-black/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-white transition-colors">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="font-medium">Mulai Mencari</span>
        </a>
        
        {popularSearch.length > 0 && (
          <div class="flex flex-wrap justify-center gap-3">
            {popularSearch.slice(0, 6).map((term: any) => (
              <a 
                href={`/search?q=${term.bookName}`} 
                class="px-4 py-1.5 rounded-full bg-zinc-900/50 hover:bg-zinc-800 text-sm text-zinc-400 hover:text-white transition-all duration-300 border border-zinc-800 hover:border-zinc-700"
              >
                {term.bookName}
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    {forYouDramas.length > 0 && (
      <section class="opacity-0 animate-fade-in-up delay-300 fill-mode-forwards">
        <div class="flex items-end justify-between mb-8 px-2">
          <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
            Rekomendasi Untuk Kamu
          </h2>
          <div class="h-1 w-20 bg-gradient-to-r from-red-600 to-transparent rounded-full mb-1.5"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
          {forYouDramas.map((drama: any) => (
            <MovieCard
              bookId={drama.bookId}
              title={drama.bookName}
              posterUrl={drama.coverWap || drama.bookCover}
              description={drama.introduction}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
