---
import Layout from '../../layouts/Layout.astro';
import MovieCard from '../../components/MovieCard.astro';
import { fetchAggregatedCategory } from '../../services/aggregator';

export function getStaticPaths() {
  return [
    { params: { slug: 'trending' } },
    { params: { slug: 'terbaru' } },
    { params: { slug: 'vip' } },
    { params: { slug: 'dub-indo' } },
    { params: { slug: 'recomendasi' } },
  ];
}

const { slug } = Astro.params;

const CATEGORY_TITLES: Record<string, string> = {
  'trending': 'Drama Trending',
  'terbaru': 'Drama Terbaru',
  'vip': 'Drama VIP',
  'dub-indo': 'Dubbing Indonesia',
  'recomendasi': 'Rekomendasi Untukmu',
};

const title = CATEGORY_TITLES[slug || ''] || 'Kategori';
let dramas: any[] = [];

if (slug) {
    dramas = await fetchAggregatedCategory(slug);
}

// Note: Infinite Scroll is temporarily disabled for aggregated categories 
// because pagination across multiple merged APIs requires a dedicated backend state.
// We will display the initial aggregated batch.
---

<Layout title={`${title} - Nonton Drama Gratis - DramaIn`}>
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">{title}</h1>
      <p class="text-zinc-400">Menampilkan daftar {title.toLowerCase()} pilihan untuk Anda.</p>
    </div>

    {dramas.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
        {dramas.map((drama: any, index: number) => (
          <MovieCard
            bookId={drama.id}
            title={drama.title}
            posterUrl={drama.cover}
            description={drama.description}
            source={drama.source}
            loading={index < 6 ? "eager" : "lazy"}
            priority={index < 6 ? "high" : "auto"}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-zinc-900 rounded-xl">
        <p class="text-zinc-500 text-lg">Tidak ada drama ditemukan untuk kategori ini.</p>
      </div>
    )}
  </div>
</Layout>
