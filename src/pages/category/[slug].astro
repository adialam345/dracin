---
import Layout from '../../layouts/Layout.astro';
import MovieCard from '../../components/MovieCard.astro';
import InfiniteScrollGrid from '../../components/InfiniteScrollGrid.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'trending' } },
    { params: { slug: 'terbaru' } },
    { params: { slug: 'vip' } },
    { params: { slug: 'dub-indo' } },
    { params: { slug: 'recomendasi' } },
  ];
}

const { slug } = Astro.params;

const CATEGORY_CONFIG: Record<string, { title: string; endpoint: string }> = {
  'trending': { title: 'Drama Trending', endpoint: '/dramabox/trending' },
  'terbaru': { title: 'Drama Terbaru', endpoint: '/dramabox/latest' },
  'vip': { title: 'Drama VIP', endpoint: '/dramabox/vip' },
  'dub-indo': { title: 'Dubbing Indonesia', endpoint: '/dramabox/dubindo?classify=terpopuler&page=1' },
  'recomendasi': { title: 'Rekomendasi Untukmu', endpoint: '/dramabox/foryou' },
};

const config = CATEGORY_CONFIG[slug || ''] || { title: 'Kategori Tidak Ditemukan', endpoint: '' };
const { title, endpoint } = config;

const API_BASE = 'https://api.sansekai.my.id/api';

let dramas = [];
try {
  const response = await fetch(`${API_BASE}${endpoint}`);
  if (response.ok) {
    const data = await response.json();
    
    // Helper to extract array from various response formats
    if (Array.isArray(data)) {
        dramas = data;
    } else if (data.data && Array.isArray(data.data)) {
        dramas = data.data;
    } else if (data.columnVoList && Array.isArray(data.columnVoList)) {
        const allBooks = [];
        data.columnVoList.forEach((column: any) => {
            if (column.bookList && Array.isArray(column.bookList)) {
                allBooks.push(...column.bookList);
            }
        });
        dramas = allBooks;
    } else if (data.bookList && Array.isArray(data.bookList)) {
        dramas = data.bookList;
    }
  }
} catch (error) {
  console.error('Error fetching category:', error);
}
---

<Layout title={`${title} - DramaKu`}>
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">{title}</h1>
      <p class="text-zinc-400">Menampilkan daftar {title.toLowerCase()} pilihan untuk Anda.</p>
    </div>

    {dramas.length > 0 ? (
      <InfiniteScrollGrid endpoint={endpoint}>
        {dramas.map((drama: any) => (
          <MovieCard
            bookId={drama.bookId}
            title={drama.bookName}
            posterUrl={drama.coverWap || drama.cover || drama.bookCover}
            description={drama.introduction}
          />
        ))}
      </InfiniteScrollGrid>
    ) : (
      <div class="text-center py-20 bg-zinc-900 rounded-xl">
        <p class="text-zinc-500 text-lg">Tidak ada drama ditemukan untuk kategori ini.</p>
      </div>
    )}
  </div>
</Layout>
