---
import Layout from '../../../../layouts/Layout.astro';
import VideoPlayer from '../../../../components/VideoPlayer.astro';
import { fetchUnifiedDramaData, fetchVideoUrl } from '../../../../services/aggregator';

const { source, bookId, episodeId } = Astro.params;

// ONLY fetch drama metadata on the server (it's fast/cached)
// DO NOT wait for video URL here, let the client fetch it for faster page shell load
const { drama, episodes } = await fetchUnifiedDramaData(source!, bookId!);

if (!drama || episodes.length === 0) {
  return Astro.redirect('/');
}

const currentEpisode = episodes.find((ep: any) => ep.id === episodeId);
const currentEpisodeIndex = episodes.findIndex((ep: any) => ep.id === episodeId);

const nextEpisode = episodes[currentEpisodeIndex + 1];
const nextEpisodeUrl = nextEpisode ? `/watch/${source}/${bookId}/${nextEpisode.id}` : undefined;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://nontonin.site"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": drama.title,
    "item": `https://nontonin.site/movie/${source}/${bookId}`
  },{
    "@type": "ListItem",
    "position": 3,
    "name": `Episode ${currentEpisodeIndex + 1}`,
    "item": `https://nontonin.site/watch/${source}/${bookId}/${episodeId}`
  }]
};
---

<Layout title={`Nonton ${drama.title} Episode ${currentEpisodeIndex + 1} Sub Indo - DramaIn`} description={drama.description} image={drama.cover}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <div class="min-h-screen">
    {/* Ambient Background */}
    <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 -z-10"></div>

    <div class="container mx-auto px-4 py-8 md:py-12 relative z-10 animate-fade-in-up">
      {/* Navigation Bar */}
      <nav class="flex items-center justify-between mb-8">
        {/* Left: Back button */}
        <a 
          href={`/movie/${source}/${bookId}`} 
          class="group flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900/50 hover:bg-zinc-800 border border-white/5 backdrop-blur-sm transition-all duration-300 hover:pr-6"
        >
          <div class="bg-zinc-800 group-hover:bg-red-600 rounded-full p-1.5 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-white transition-colors">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </div>
          <span class="text-sm font-medium text-zinc-300 group-hover:text-white transition-colors">Kembali ke Detail</span>
        </a>
        
        {/* Right: Error Report Button */}
        <button 
          id="reportErrorBtn"
          class="group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-orange-600/20 hover:bg-orange-600/40 border border-orange-500/30 hover:border-orange-500/60 backdrop-blur-sm transition-all duration-300"
          title="Laporkan jika video error"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400 group-hover:text-orange-200 transition-colors">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span class="text-xs font-medium text-orange-300 group-hover:text-orange-100 transition-colors">Error?</span>
        </button>
      </nav>
      
      {/* Toast Notification */}
      <div id="errorToast" class="fixed top-4 right-4 z-50 transform translate-x-full opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-green-600 text-white px-6 py-3 rounded-xl shadow-lg shadow-green-600/30 flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span class="font-medium">Laporan terkirim! Gunakan browser Chrome jika masih error</span>
        </div>
      </div>

      <div class="max-w-5xl mx-auto">
        
        {/* Main Content: Video Player */}
        <div class="space-y-6">
          <div class="relative group">
            {/* Player Container */}
            <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50 bg-zinc-900 border border-white/5 aspect-video md:aspect-[21/9] lg:aspect-video">
              <VideoPlayer 
                title={drama.title} 
                poster={drama.cover} 
                source={source}
                bookId={bookId}
                episodeId={episodeId}
                nextEpisodeUrl={nextEpisodeUrl}
                episodes={episodes}
              />
            </div>
          </div>

          {/* Episode Info */}
          <div 
            class="bg-zinc-900/40 backdrop-blur-md rounded-2xl p-6 border border-white/10"
            data-drama-title={drama.title}
            data-drama-source={source}
            data-episode-number={currentEpisodeIndex + 1}
          >
            <h1 class="text-2xl md:text-3xl font-bold text-white mb-2 leading-tight">
              {drama.title}
            </h1>
            
            {drama.description && (
              <p class="text-zinc-400 leading-relaxed text-sm md:text-base mt-2 line-clamp-2">
                {drama.description}
              </p>
            )}
          </div>

          {/* Episode Grid List */}
          <div class="bg-zinc-900/40 backdrop-blur-md rounded-2xl p-6 border border-white/10">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <span class="w-1 h-6 bg-red-600 rounded-full"></span>
                Daftar Episode
              </h2>
              <span class="text-zinc-400 text-sm">
                Episode {currentEpisodeIndex + 1} / {episodes.length}
              </span>
            </div>
            
            <div class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-12 gap-2 max-h-[400px] overflow-y-auto custom-scrollbar pr-2">
              {episodes.map((episode: any, index: number) => {
                const isActive = episode.id === episodeId;
                return (
                    <a
                      href={`/watch/${source}/${bookId}/${episode.id}`}
                      data-episode-id={episode.id}
                      data-astro-prefetch="false"
                      class={`group relative flex items-center justify-center aspect-square rounded-lg text-sm font-semibold transition-all duration-300 border ${
                        isActive
                          ? 'bg-cyan-500 border-cyan-400 text-black shadow-[0_0_15px_rgba(6,182,212,0.5)] scale-105 z-10'
                          : 'bg-zinc-800/50 border-white/5 text-zinc-400 hover:bg-zinc-700/80 hover:text-white hover:border-white/20'
                      }`}
                    >
                    {index + 1}
                    
                    {/* VIP/Lock Indicator if needed in future */}

                  </a>
                );
              })}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <style>
    /* Custom Scrollbar for Episode List */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.2);
    }
  </style>
</Layout>

<script>
  function updateWatchedEpisodes() {
    const parts = window.location.pathname.split('/').filter(Boolean);
    // Expected: ['watch', source, bookId, episodeId]
    if(parts.length < 3 || parts[0] !== 'watch') return;
    
    const source = parts[1];
    const bookId = parts[2];
    // We don't need episodeId here, we check all of them
    
    const key = `watched:${source}:${bookId}`;
    let watchedList = [];
    try {
        watchedList = JSON.parse(localStorage.getItem(key) || '[]');
    } catch(e) { console.error(e); }
    
    if (!Array.isArray(watchedList)) return;

    const episodeLinks = document.querySelectorAll('a[data-episode-id]');
    
    episodeLinks.forEach(link => {
       const id = link.getAttribute('data-episode-id');
       const isActive = link.classList.contains('bg-cyan-500'); // Check if it's the currently playing one
       
       if (watchedList.includes(id) && !isActive) {
           // Apply Watched Style (Orange)
           link.classList.remove('bg-zinc-800/50', 'text-zinc-400', 'border-white/5', 'hover:bg-zinc-700/80', 'hover:text-white', 'hover:border-white/20');
           link.classList.add('bg-orange-700', 'text-orange-100', 'border-orange-500', 'hover:bg-orange-600');
       }
    });
  }

  // Run on initial load, navigation, and when history updates
  document.addEventListener('astro:page-load', updateWatchedEpisodes);
  document.addEventListener('DOMContentLoaded', updateWatchedEpisodes); // Fallback
  window.addEventListener('watched-episode-added', updateWatchedEpisodes);

  // Error Report Button Handler
  function initErrorReportButton() {
    const reportBtn = document.getElementById('reportErrorBtn');
    const toast = document.getElementById('errorToast');
    
    if (reportBtn && toast) {
      reportBtn.addEventListener('click', async () => {
        // Disable button to prevent spam
        reportBtn.setAttribute('disabled', 'true');
        reportBtn.classList.add('opacity-50', 'cursor-not-allowed');
        
        try {
          // Send error report to admin
          await fetch('/api/admin/error-reports', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              url: window.location.href
            })
          });
          
          // Show success toast
          toast.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
          toast.classList.add('translate-x-0', 'opacity-100');
          
          // Refresh page after delay
          setTimeout(() => {
            window.location.reload();
          }, 3000);
          
        } catch (error) {
          console.error('Failed to send error report:', error);
          // Still refresh even if report fails
          window.location.reload();
        }
      });
    }
  }
  
  document.addEventListener('astro:page-load', initErrorReportButton);
  document.addEventListener('DOMContentLoaded', initErrorReportButton);
</script>
