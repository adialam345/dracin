---
import Layout from '../../../../layouts/Layout.astro';
import VideoPlayer from '../../../../components/VideoPlayer.astro';
import { fetchUnifiedDetail, fetchUnifiedEpisodes, fetchVideoUrl } from '../../../../services/aggregator';

const { source, bookId, episodeId } = Astro.params;

const drama = await fetchUnifiedDetail(source!, bookId!);
const episodes = await fetchUnifiedEpisodes(source!, bookId!);
const videoUrl = await fetchVideoUrl(source!, bookId!, episodeId!);

if (!drama || episodes.length === 0) {
  return Astro.redirect('/');
}

const currentEpisode = episodes.find((ep: any) => ep.id === episodeId);
const currentEpisodeIndex = episodes.findIndex((ep: any) => ep.id === episodeId);

if (!currentEpisode) {
  return Astro.redirect(`/movie/${source}/${bookId}`);
}
---

<Layout title={`Nonton ${drama.title} - Episode ${currentEpisodeIndex + 1} - DramaKu`}>
  <div class="min-h-screen">
    {/* Ambient Background */}
    <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 -z-10"></div>

    <div class="container mx-auto px-4 py-8 md:py-12 relative z-10 animate-fade-in-up">
      {/* Navigation Bar */}
      <nav class="flex items-center justify-between mb-8">
        <a 
          href={`/movie/${source}/${bookId}`} 
          class="group flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900/50 hover:bg-zinc-800 border border-white/5 backdrop-blur-sm transition-all duration-300 hover:pr-6"
        >
          <div class="bg-zinc-800 group-hover:bg-red-600 rounded-full p-1.5 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-white transition-colors">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </div>
          <span class="text-sm font-medium text-zinc-300 group-hover:text-white transition-colors">Kembali ke Detail</span>
        </a>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        
        {/* Main Content: Video Player */}
        <div class="lg:col-span-3 space-y-6">
          <div class="relative group">
            {/* Player Container */}
            <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50 bg-zinc-900 border border-white/5 aspect-video md:aspect-[21/9] lg:aspect-video">
              {videoUrl ? (
                <VideoPlayer videoUrl={videoUrl} title={drama.title} poster={drama.cover} />
              ) : (
                <div class="absolute inset-0 flex flex-col items-center justify-center bg-zinc-900/90 gap-4">
                  <div class="w-16 h-16 rounded-full bg-zinc-800/50 flex items-center justify-center border border-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-600">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="8" x2="12" y2="12"></line>
                      <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                  </div>
                  <p class="text-zinc-400 font-medium">Video tidak tersedia untuk episode ini</p>
                </div>
              )}
            </div>
          </div>

          {/* Episode Info */}
          <div class="bg-zinc-900/40 backdrop-blur-md rounded-2xl p-6 border border-white/5">
            <h1 class="text-2xl md:text-3xl font-bold text-white mb-2 leading-tight">
              {drama.title}
            </h1>
            <div class="flex items-center gap-2 text-zinc-400 text-sm md:text-base mb-6">
              <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-zinc-300">
                Episode {currentEpisodeIndex + 1}
              </span>
              {currentEpisode.name && (
                <>
                  <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
                  <span>{currentEpisode.name}</span>
                </>
              )}
            </div>

            {drama.description && (
              <div class="space-y-3">
                <h3 class="text-sm uppercase tracking-wider text-zinc-500 font-semibold">Sinopsis</h3>
                <p class="text-zinc-300 leading-relaxed text-sm md:text-base">
                  {drama.description}
                </p>
              </div>
            )}
          </div>
        </div>

        {/* Sidebar: Episode List */}
        <div class="lg:col-span-1">
          <div class="sticky top-24 bg-zinc-900/40 backdrop-blur-md rounded-2xl border border-white/5 overflow-hidden flex flex-col max-h-[calc(100vh-6rem)]">
            <div class="p-4 border-b border-white/5 bg-zinc-900/50 backdrop-blur-xl z-20">
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500">
                  <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                Daftar Episode
              </h2>
            </div>
            
            <div class="overflow-y-auto p-2 space-y-1 custom-scrollbar flex-1">
              {episodes.map((episode: any, index: number) => {
                const isActive = episode.id === episodeId;
                return (
                  <a
                    href={`/watch/${source}/${bookId}/${episode.id}`}
                    class={`group relative flex items-center gap-3 p-3 rounded-xl transition-all duration-300 ${
                      isActive
                        ? 'bg-gradient-to-r from-red-600 to-red-700 text-white shadow-lg shadow-red-900/20 z-10 scale-[1.02]'
                        : 'bg-transparent text-zinc-400 hover:bg-white/5 hover:text-white'
                    }`}
                  >
                    <div class={`flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center text-sm font-bold transition-all duration-300 ${
                      isActive 
                        ? 'bg-white/20 text-white backdrop-blur-sm' 
                        : 'bg-zinc-800/80 group-hover:bg-zinc-700 text-zinc-500 group-hover:text-zinc-300'
                    }`}>
                      {isActive ? (
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0" stroke-linecap="round" stroke-linejoin="round">
                          <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                      ) : (
                        index + 1
                      )}
                    </div>
                    
                    <div class="flex-1 min-w-0">
                      <p class={`text-sm font-medium truncate ${isActive ? 'text-white' : 'text-zinc-300 group-hover:text-white'}`}>
                        Episode {episode.index + 1}
                      </p>
                      {episode.name && (
                        <p class={`text-xs truncate transition-colors ${isActive ? 'text-red-100/80' : 'text-zinc-500 group-hover:text-zinc-400'}`}>
                          {episode.name}
                        </p>
                      )}
                    </div>

                    {/* Active Indicator Line (Optional aesthetic touch) */}
                    {isActive && (
                      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-8 bg-white/20 rounded-l-full"></div>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <style>
    /* Custom Scrollbar for Episode List */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.2);
    }
  </style>
</Layout>
