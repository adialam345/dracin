---
// Example implementation of infinite scroll in search page
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import SkeletonLoader from '../components/SkeletonLoader.astro';
import InfiniteScroll from '../components/InfiniteScroll.astro';

const query = Astro.url.searchParams.get('q') || '';
const initialPage = 1;
const pageSize = 12; // Load 12 items per page
---

<Layout title={`Hasil pencarian: ${query} - DramaIn`}>
  <div class="min-h-screen bg-gradient-to-b from-black via-zinc-900 to-black pt-20 pb-24">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold text-white mb-8">
        Hasil pencarian: <span class="text-red-500">{query}</span>
      </h1>

      {/* Initial results container */}
      <div id="results-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
        {/* Initial results will be loaded here */}
      </div>

      {/* Loading skeleton */}
      <div id="loading-skeleton" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 mt-6">
        <SkeletonLoader count={pageSize} />
      </div>

      {/* Infinite scroll trigger */}
      <InfiniteScroll />
    </div>
  </div>
</Layout>

<script>
  // Client-side infinite scroll implementation
  let currentPage = 1;
  let isLoading = false;
  let hasMore = true;
  const pageSize = 12;
  const query = new URLSearchParams(window.location.search).get('q') || '';

  async function loadResults(page: number) {
    if (isLoading || !hasMore) return;
    
    isLoading = true;
    const skeleton = document.getElementById('loading-skeleton');
    if (skeleton) skeleton.style.display = 'grid';

    try {
      // Fetch results from API
      const response = await fetch(`/api/search?q=${encodeURIComponent(query)}&page=${page}&size=${pageSize}`);
      const data = await response.json();

      const grid = document.getElementById('results-grid');
      if (!grid) return;

      // Render results
      data.results.forEach((item: any) => {
        const card = createMovieCard(item);
        grid.appendChild(card);
      });

      hasMore = data.hasMore;
      
      // Notify infinite scroll component
      window.dispatchEvent(new CustomEvent('loadingComplete', {
        detail: { hasMore }
      }));

    } catch (error) {
      console.error('Error loading results:', error);
    } finally {
      isLoading = false;
      if (skeleton) skeleton.style.display = 'none';
    }
  }

  function createMovieCard(item: any) {
    // Create movie card element
    const div = document.createElement('div');
    div.innerHTML = `
      <a href="/movie/${item.source}/${item.id}" class="group block relative">
        <div class="relative overflow-hidden rounded-2xl bg-zinc-900/50 aspect-[2/3] transition-all duration-500 ease-out group-hover:shadow-[0_8px_30px_rgb(0,0,0,0.5)]">
          <img
            src="${item.cover}"
            alt="${item.title}"
            loading="lazy"
            class="w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-110 opacity-0"
            onload="this.classList.remove('opacity-0')"
          />
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <h3 class="font-medium text-white text-base leading-tight line-clamp-2">
              ${item.title}
            </h3>
          </div>
        </div>
      </a>
    `;
    return div.firstElementChild!;
  }

  // Load initial results
  loadResults(currentPage);

  // Listen for infinite scroll trigger
  window.addEventListener('loadMore', () => {
    currentPage++;
    loadResults(currentPage);
  });
</script>
