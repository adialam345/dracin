---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import ContinueWatching from '../components/ContinueWatching.astro';
import SearchModal from '../components/SearchModal.astro';
import AnalyticsTracker from '../components/AnalyticsTracker.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
}

const {
  title = 'DramaIn - Platform Streaming Drama Terbaik',
  description = 'Nonton drama gratis dari DramaBox, NetShort, RadReel, ShortMax, StarShort, DramaWave, Melolo, FlickReels, GoodShort, HiShort, FreeShort, dan DramaDash. Platform streaming modern, cepat, dan ringan.',
  image = '/og-image.png',
  hideFooter = false
} = Astro.props;

const socialImageURL = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <ViewTransitions />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:locale" content="id_ID" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="DramaIn" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    {/* Mobile Web App Meta Tags */}
    <meta name="theme-color" content="#09090b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-zinc-950 text-white selection:bg-red-500/30">
    <Header />
    <main class="flex-grow pt-20 pb-20 md:pb-0">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <BottomNav />
    <ContinueWatching />
    <SearchModal />
    <AnalyticsTracker />
    {/* Global Loading Bar */}
    <div id="loading-bar" class="loading-bar"></div>

    <script>
      // Global Page Transition Loading Bar
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('loading-bar');
        if (bar) bar.classList.add('loading-bar-animate');
      });

      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('loading-bar');
        if (bar) bar.classList.remove('loading-bar-animate');
      });
    </script>
  </body>
</html>
