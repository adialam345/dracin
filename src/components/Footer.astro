---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-zinc-950/30 backdrop-blur-md mt-20">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col items-center justify-center gap-4">
      <div class="flex items-center gap-1 scale-110">

         <div class="flex items-center font-black tracking-tighter text-xl filter drop-shadow-[2px_2px_2px_rgba(0,0,0,0.9)]">
             <img 
               src="/6f0fdaf5-e38a-48ad-a23e-ad6a39dd0b9f_removalai_preview.png" 
               alt="D" 
               width="28" 
               height="28" 
               class="h-7 w-auto -mr-0.5 object-contain" 
               style="max-width: 28px;" 
             />
             <span class="bg-gradient-to-b from-white via-gray-200 to-gray-500 bg-clip-text text-transparent">rama</span>
             <span class="text-[#E50914]">In</span>
         </div>
      </div>

      <p class="text-sm text-zinc-400 text-center">
        Platform streaming drama modern dan ringan
      </p>

      <div class="flex items-center gap-4 text-sm text-zinc-500">
        <span>&copy; {currentYear} DramaIn</span>
        <span>•</span>
        <a href="https://www.instagram.com/kidiepie_/" target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform duration-300 font-bold">
          <span>Made By <span class="animate-text-gradient">Antarixa</span></span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 767px) {
    footer {
      padding-bottom: calc(5rem + env(safe-area-inset-bottom));
    }
  }

  .animate-text-gradient {
    background: linear-gradient(
      to right,
      #ef4444,
      #f59e0b,
      #ef4444
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textGradient 3s linear infinite;
  }

  @keyframes textGradient {
    to {
      background-position: 200% center;
    }
  }
</style>

