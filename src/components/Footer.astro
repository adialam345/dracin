---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-zinc-950/30 backdrop-blur-md mt-20">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col items-center justify-center gap-4">
      <div class="flex items-center gap-1 scale-110">
         <div class="relative flex items-center justify-center mr-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-[#E50914] drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]">
               <path d="M5 3.868v16.264c0 .882.991 1.405 1.715.908l13.011-8.132a1.06 1.06 0 0 0 0-1.816L6.715 2.96C5.991 2.463 5 2.986 5 3.868z" />
            </svg>
         </div>
         <div class="flex items-baseline font-black tracking-tighter text-xl filter drop-shadow-[2px_2px_2px_rgba(0,0,0,0.9)]">
             <span class="bg-gradient-to-b from-white via-gray-200 to-gray-500 bg-clip-text text-transparent">Drama</span>
             <span class="text-[#E50914]">In</span>
         </div>
      </div>

      <p class="text-sm text-zinc-400 text-center">
        Platform streaming drama modern dan ringan
      </p>

      <div class="flex items-center gap-4 text-sm text-zinc-500">
        <span>&copy; {currentYear} DramaIn</span>
        <span>•</span>
        <span>Dibuat dengan Astro</span>
      </div>
    </div>
  </div>
</footer>
