---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-zinc-950/30 backdrop-blur-md mt-20">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col items-center justify-center gap-4">
      <div class="flex items-center gap-1 scale-110">

         <div class="flex items-center font-black tracking-tighter text-xl filter drop-shadow-[2px_2px_2px_rgba(0,0,0,0.9)]">
             <img 
               src="/logo.webp" 
               alt="D" 
               width="28" 
               height="28" 
               class="h-7 w-auto -mr-0.5 object-contain" 
               style="max-width: 28px;" 
             />
             <span class="bg-gradient-to-b from-white via-gray-200 to-gray-500 bg-clip-text text-transparent">rama</span>
             <span class="text-[#E50914]">In</span>
         </div>
      </div>

      <p class="text-sm text-zinc-400 text-center">
        Platform streaming drama modern dan ringan
      </p>

      <div class="flex items-center gap-4 text-sm text-zinc-500">
        <span>&copy; {currentYear} DramaIn</span>
        <span>•</span>
        <span>Made By Antarixa</span>
      </div>
    </div>
  </div>
</footer>
