---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-zinc-950/30 backdrop-blur-md mt-20">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col items-center justify-center gap-4">
      <div class="flex items-center gap-2">
         <div class="relative flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-red-600/80">
               <path d="M5 3.868v16.264c0 .882.991 1.405 1.715.908l13.011-8.132a1.06 1.06 0 0 0 0-1.816L6.715 2.96C5.991 2.463 5 2.986 5 3.868z" />
            </svg>
         </div>
         <span class="text-xl font-bold text-zinc-300 tracking-tight">Drama<span class="text-red-500/80">Ku</span></span>
      </div>

      <p class="text-sm text-zinc-400 text-center">
        Platform streaming drama modern dan ringan
      </p>

      <div class="flex items-center gap-4 text-sm text-zinc-500">
        <span>&copy; {currentYear} DramaKu</span>
        <span>•</span>
        <span>Dibuat dengan Astro</span>
      </div>
    </div>
  </div>
</footer>
