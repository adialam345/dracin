---
const currentPath = Astro.url.pathname;

const navItems = [
  { 
    label: 'Beranda', 
    href: '/', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>' 
  },
  { 
    label: 'Trending', 
    href: '/category/trending', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>' 
  },
  { 
    label: 'Cari', 
    href: '/search', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>' 
  },
  { 
    label: 'VIP', 
    href: '/category/vip', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><rect width="12" height="12" x="6" y="6" rx="2"/></svg>' 
  },
];
---

<nav class="fixed bottom-0 left-0 right-0 z-50 bg-zinc-950/80 backdrop-blur-xl border-t border-white/5 md:hidden pb-safe">
  <div class="flex items-center justify-around h-16">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a 
          href={item.href} 
          class={`flex flex-col items-center justify-center w-full h-full gap-1 transition-all duration-300 ${
            isActive ? 'text-red-500' : 'text-zinc-500 hover:text-zinc-300'
          }`}
        >
          <div class={`w-6 h-6 transition-transform duration-300 ${isActive ? 'scale-110' : ''}`} set:html={item.icon} />
          <span class="text-[10px] font-medium tracking-wide">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  /* Safe area padding for iPhones with home indicator */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
