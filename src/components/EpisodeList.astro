---
interface Episode {
  id: string;
  name: string;
  index: number;
  duration?: number;
  unlock?: boolean;
}

interface Props {
  episodes: Episode[];
  bookId: string;
  source: string;
}

const { episodes, bookId, source } = Astro.props;

function formatDuration(ms?: number) {
  if (!ms) return '';
  const seconds = Math.floor(ms / 1000);
  const minutes = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return `${minutes}:${secs.toString().padStart(2, '0')}`;
}
---

<div class="space-y-3">
  {episodes.map((episode) => (
    <a
      href={`/watch/${source}/${bookId}/${episode.id}`}
      class="block p-4 bg-zinc-900 hover:bg-zinc-800 rounded-lg transition-colors duration-300 group relative"
      data-astro-prefetch="false"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-zinc-800 group-hover:bg-red-500/20 rounded-lg flex items-center justify-center transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-red-500 transition-colors duration-300">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
          </div>
          <div>
            <h3 class="font-medium text-white group-hover:text-red-500 transition-colors duration-300">
              Episode {episode.index + 1}
            </h3>
            {episode.name && (
              <p class="text-sm text-zinc-400 mt-1">
                {episode.name}
              </p>
            )}
          </div>
        </div>
        {episode.duration && (
          <span class="text-sm text-zinc-500">
            {formatDuration(episode.duration)}
          </span>
        )}
      </div>

    </a>
  ))}
</div>
