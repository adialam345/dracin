---
interface Props {
  endpoint: string;
  initialPage?: number;
}

const { endpoint, initialPage = 1 } = Astro.props;
---

<div id="infinite-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10" data-endpoint={endpoint} data-page={initialPage}>
  <slot />
</div>

<div id="loading-sentinel" class="w-full py-12 flex justify-center items-center opacity-0 transition-opacity duration-300">
  <div class="flex gap-2">
    <div class="w-3 h-3 rounded-full bg-red-500 animate-bounce"></div>
    <div class="w-3 h-3 rounded-full bg-red-500 animate-bounce [animation-delay:-0.15s]"></div>
    <div class="w-3 h-3 rounded-full bg-red-500 animate-bounce [animation-delay:-0.3s]"></div>
  </div>
</div>

<script>
  let currentPage = 1;
  let isLoading = false;
  let hasMore = true;

  const grid = document.getElementById('infinite-grid');
  const sentinel = document.getElementById('loading-sentinel');
  const endpoint = grid?.dataset.endpoint;

  if (grid && sentinel && endpoint) {
    currentPage = parseInt(grid.dataset.page || '1');

    const observer = new IntersectionObserver(async (entries) => {
      const entry = entries[0];
      if (entry.isIntersecting && !isLoading && hasMore) {
        isLoading = true;
        sentinel.classList.remove('opacity-0');

        try {
          const nextPage = currentPage + 1;
          const response = await fetch(`/partials/drama-list?endpoint=${encodeURIComponent(endpoint)}&page=${nextPage}`);
          
          if (response.ok) {
            const html = await response.text();
            if (html.trim().length === 0) {
              hasMore = false;
              sentinel.style.display = 'none';
            } else {
              // Create a temp container to parse HTML string into nodes
              const temp = document.createElement('div');
              temp.innerHTML = html;
              
              const newItems = Array.from(temp.children);
              
              // Append to grid with staggered animation
              newItems.forEach((item, index) => {
                grid.appendChild(item);
              });
              
              currentPage = nextPage;
            }
          } else {
            hasMore = false;
          }
        } catch (error) {
          console.error('Error fetching more items:', error);
          hasMore = false;
        } finally {
          isLoading = false;
          sentinel.classList.add('opacity-0');
        }
      }
    }, {
      rootMargin: '200px', // Start loading before reaching bottom
    });

    observer.observe(sentinel);
  }
</script>
