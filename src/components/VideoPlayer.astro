---
interface Props {
  videoUrl: string;
  title: string;
  poster?: string;
}

const { videoUrl, title, poster } = Astro.props;
const isHLS = videoUrl.includes('.m3u8') || videoUrl.includes('playlist.m3u8');
---

<div class="relative bg-black w-full h-full group" id="video-container">
  <video
    id="video-player"
    class="w-full h-full object-contain"
    controls
    preload="auto"
    poster={poster}
    data-video-url={videoUrl}
    data-is-hls={isHLS}
    playsinline
    crossorigin="anonymous"
  >
    Browser Anda tidak mendukung video player.
  </video>
</div>

<script>
  import Hls from 'hls.js';

  const videoElement = document.getElementById('video-player') as HTMLVideoElement;
  const videoUrl = videoElement?.getAttribute('data-video-url');
  const isHLS = videoElement?.getAttribute('data-is-hls') === 'true';

  if (videoElement && videoUrl) {
    console.log(`[VideoPlayer] Initializing for ${isHLS ? 'HLS' : 'MP4'}: ${videoUrl}`);
    
    if (isHLS) {
      if (Hls.isSupported()) {
        const hls = new Hls({
          enableWorker: true,
          lowLatencyMode: true,
        });

        hls.loadSource(videoUrl);
        hls.attachMedia(videoElement);

        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          console.log('[VideoPlayer] HLS manifest loaded');
        });

        hls.on(Hls.Events.ERROR, (event, data) => {
          if (data.fatal) {
            switch (data.type) {
              case Hls.ErrorTypes.NETWORK_ERROR:
                console.error('[VideoPlayer] Network error', data);
                hls.startLoad();
                break;
              case Hls.ErrorTypes.MEDIA_ERROR:
                console.error('[VideoPlayer] Media error', data);
                hls.recoverMediaError();
                break;
              default:
                hls.destroy();
                break;
            }
          }
        });
      } else if (videoElement.canPlayType('application/vnd.apple.mpegurl')) {
        videoElement.src = videoUrl;
      }
    } else {
      // Normal MP4 playback
      videoElement.src = videoUrl;
      videoElement.load();
    }
  }
</script>
