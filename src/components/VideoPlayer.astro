---
interface Props {
  videoUrl?: string;
  title: string;
  poster?: string;
  source?: string;
  bookId?: string;
  episodeId?: string;
  nextEpisodeUrl?: string;
  episodes?: any[];
}

const { videoUrl: initialVideoUrl, title, poster, source, bookId, episodeId, nextEpisodeUrl, episodes = [] } = Astro.props;
---

<div class="relative bg-black w-full h-full group overflow-hidden" id="video-container">
  {/* Data store for episodes */}
  <script type="application/json" id="episode-data" set:html={JSON.stringify(episodes.map(e => ({ id: e.id, index: e.index })))}></script>
  {/* Loading Spinner overlay */}
  <div id="player-loader" class="absolute inset-0 flex flex-col items-center justify-center bg-zinc-950 z-20 transition-opacity duration-500">
    <div class="relative">
      <div class="w-16 h-16 border-4 border-red-500/20 border-t-red-600 rounded-full animate-spin"></div>
      <div class="absolute inset-0 flex items-center justify-center">
         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-red-600 animate-pulse">
            <path d="M5 3.868v16.264c0 .882.991 1.405 1.715.908l13.011-8.132a1.06 1.06 0 0 0 0-1.816L6.715 2.96C5.991 2.463 5 2.986 5 3.868z" />
         </svg>
      </div>
    </div>
    <p class="mt-4 text-zinc-400 text-sm font-medium animate-pulse">Menyiapkan Putar Video...</p>
  </div>

  <video
    id="video-player"
    class="w-full h-full object-contain opacity-0 transition-opacity duration-700"
    controls
    preload="metadata"
    poster={poster}
    data-video-url={initialVideoUrl}
    data-source={source}
    data-book-id={bookId}
    data-episode-id={episodeId}
    data-next-episode-url={nextEpisodeUrl}
    playsinline
    webkit-playsinline
    x5-playsinline
    disablePictureInPicture={false}
    controlsList="nodownload"
    crossorigin="anonymous"
  >
    Browser Anda tidak mendukung video player.
  </video>

  {/* Custom Subtitle Overlay - for consistent styling across all platforms */}
  <div id="subtitle-overlay" class="absolute left-0 right-0 bottom-[12%] flex justify-center items-end pointer-events-none z-10 px-4">
    <div id="subtitle-text" class="text-center text-white font-semibold text-lg md:text-xl leading-relaxed max-w-[90%]" style="text-shadow: 2px 2px 2px rgba(0,0,0,0.9), 0 0 8px rgba(0,0,0,0.8), -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;"></div>
  </div>

  {/* Custom Fullscreen Button for Mobile - shows on touch devices */}
  <button id="ios-fullscreen-btn" class="absolute bottom-4 right-4 z-30 bg-black/70 hover:bg-black/90 active:bg-black text-white p-3 rounded-full transition-all" style="display: none;" title="Fullscreen">
    <svg id="fs-icon-expand" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
    <svg id="fs-icon-compress" style="display: none;" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 14 10 14 10 20"></polyline>
      <polyline points="20 10 14 10 14 4"></polyline>
      <line x1="14" y1="10" x2="21" y2="3"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
  </button>

  {/* Error State */}
  <div id="player-error" class="hidden absolute inset-0 flex flex-col items-center justify-center bg-zinc-950/90 z-20 p-6 text-center">
    <div class="w-16 h-16 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>
    <h3 class="text-white font-bold mb-2">Video Tidak Dapat Dimuat</h3>
    <p class="text-zinc-400 text-sm mb-6">Maaf, terjadi kesalahan saat menyiapkan streaming video ini.</p>
    <button onclick="window.location.reload()" class="px-6 py-2 bg-zinc-800 hover:bg-zinc-700 text-white rounded-full text-sm font-medium transition-colors">
      Coba Lagi
    </button>
  </div>
</div>

<style>
  /* Custom Subtitle Styling */
  /* Using both ID and element selector for better specificity */
  #video-player::cue,
  video::cue {
    background-color: transparent !important;
    background: transparent !important;
    color: white;
    font-size: 1.1em;
    font-weight: 600;
    text-shadow: 
      2px 2px 2px rgba(0, 0, 0, 0.9),
      0px 0px 4px rgba(0, 0, 0, 0.8),
      -1px -1px 0 rgba(0, 0, 0, 1),
      1px -1px 0 rgba(0, 0, 0, 1),
      -1px 1px 0 rgba(0, 0, 0, 1),
      1px 1px 0 rgba(0, 0, 0, 1);
    line-height: normal;
  }

  /* WebKit/iOS Safari Specific Overrides to remove default background box */
  #video-player::-webkit-media-text-track-container {
    bottom: 15% !important;
    overflow: visible !important;
  }

  #video-player::-webkit-media-text-track-display {
    background-color: transparent !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  #video-player::-webkit-media-text-track-background {
    background-color: transparent !important;
    background: transparent !important;
  }

  /* Ensure text track region doesn't clip shadows */
  #video-player::-webkit-media-text-track-region {
    background: transparent !important;
    background-color: transparent !important;
  }

  /* iOS Fake Fullscreen Mode - uses CSS to fill screen instead of native fullscreen */
  #video-container.ios-fullscreen {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 9999 !important;
    background: black !important;
  }

  #video-container.ios-fullscreen #video-player {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }

  #video-container.ios-fullscreen #subtitle-overlay {
    bottom: 8% !important;
  }

  #video-container.ios-fullscreen #ios-fullscreen-btn {
    bottom: 16px !important;
    right: 16px !important;
  }

  /* Hide native fullscreen button on iOS when using fake fullscreen */
  @supports (-webkit-touch-callout: none) {
    #video-player::-webkit-media-controls-fullscreen-button {
      display: none !important;
    }
  }
</style>

<script>
  import Hls from 'hls.js';

  // Custom Subtitle Renderer Class - renders subtitles as HTML overlay
  class CustomSubtitleRenderer {
    private videoElement: HTMLVideoElement;
    private subtitleContainer: HTMLElement | null;
    private cues: Array<{ start: number; end: number; text: string }> = [];
    private currentCueIndex: number = -1;
    private isActive: boolean = false;

    constructor(videoElement: HTMLVideoElement) {
      this.videoElement = videoElement;
      this.subtitleContainer = document.getElementById('subtitle-text');
      this.onTimeUpdate = this.onTimeUpdate.bind(this);
    }

    // Parse VTT/SRT content
    async loadFromUrl(url: string): Promise<void> {
      try {
        console.log('[CustomSubtitle] Loading subtitle from:', url);
        const response = await fetch(url);
        if (!response.ok) throw new Error(`Failed to fetch subtitle: ${response.status}`);
        
        const text = await response.text();
        this.cues = this.parseSubtitle(text);
        console.log('[CustomSubtitle] Parsed', this.cues.length, 'cues');
        
        if (this.cues.length > 0) {
          this.activate();
        }
      } catch (e) {
        console.error('[CustomSubtitle] Failed to load subtitle:', e);
      }
    }

    private parseSubtitle(content: string): Array<{ start: number; end: number; text: string }> {
      const cues: Array<{ start: number; end: number; text: string }> = [];
      
      // Normalize line endings
      content = content.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      
      // Remove WEBVTT header if present
      content = content.replace(/^WEBVTT.*?\n\n/s, '');
      
      // Split into blocks
      const blocks = content.split(/\n\n+/);
      
      for (const block of blocks) {
        const lines = block.trim().split('\n');
        if (lines.length < 2) continue;
        
        // Find the timing line (contains -->)
        let timingLineIndex = lines.findIndex(line => line.includes('-->'));
        if (timingLineIndex === -1) continue;
        
        const timingLine = lines[timingLineIndex];
        const match = timingLine.match(/(\d{1,2}:)?(\d{2}):(\d{2})[,.](\d{3})\s*-->\s*(\d{1,2}:)?(\d{2}):(\d{2})[,.](\d{3})/);
        
        if (match) {
          const startHours = match[1] ? parseInt(match[1]) : 0;
          const startMinutes = parseInt(match[2]);
          const startSeconds = parseInt(match[3]);
          const startMs = parseInt(match[4]);
          
          const endHours = match[5] ? parseInt(match[5]) : 0;
          const endMinutes = parseInt(match[6]);
          const endSeconds = parseInt(match[7]);
          const endMs = parseInt(match[8]);
          
          const start = startHours * 3600 + startMinutes * 60 + startSeconds + startMs / 1000;
          const end = endHours * 3600 + endMinutes * 60 + endSeconds + endMs / 1000;
          
          // Get text lines after timing
          const textLines = lines.slice(timingLineIndex + 1);
          const text = textLines.join('\n').trim();
          
          if (text) {
            cues.push({ start, end, text });
          }
        }
      }
      
      // Sort by start time
      cues.sort((a, b) => a.start - b.start);
      
      return cues;
    }

    private parseTime(timeStr: string): number {
      // Handle both HH:MM:SS,mmm and MM:SS,mmm formats
      const parts = timeStr.replace(',', '.').split(':');
      if (parts.length === 3) {
        return parseFloat(parts[0]) * 3600 + parseFloat(parts[1]) * 60 + parseFloat(parts[2]);
      } else if (parts.length === 2) {
        return parseFloat(parts[0]) * 60 + parseFloat(parts[1]);
      }
      return 0;
    }

    activate(): void {
      if (this.isActive) return;
      this.isActive = true;
      this.videoElement.addEventListener('timeupdate', this.onTimeUpdate);
      console.log('[CustomSubtitle] Renderer activated');
    }

    deactivate(): void {
      this.isActive = false;
      this.videoElement.removeEventListener('timeupdate', this.onTimeUpdate);
      if (this.subtitleContainer) {
        this.subtitleContainer.textContent = '';
      }
      console.log('[CustomSubtitle] Renderer deactivated');
    }

    private onTimeUpdate(): void {
      if (!this.subtitleContainer || this.cues.length === 0) return;
      
      const currentTime = this.videoElement.currentTime;
      
      // Find active cue
      let activeCue: { start: number; end: number; text: string } | null = null;
      for (const cue of this.cues) {
        if (currentTime >= cue.start && currentTime <= cue.end) {
          activeCue = cue;
          break;
        }
      }
      
      if (activeCue) {
        // Clean text (remove HTML tags, decode entities)
        let cleanText = activeCue.text
          .replace(/<[^>]+>/g, '') // Remove HTML tags
          .replace(/\{[^}]+\}/g, '') // Remove ASS/SSA styles
          .replace(/&amp;/g, '&')
          .replace(/&lt;/g, '<')
          .replace(/&gt;/g, '>')
          .replace(/&quot;/g, '"');
        
        this.subtitleContainer.innerHTML = cleanText.replace(/\n/g, '<br>');
      } else {
        this.subtitleContainer.textContent = '';
      }
    }

    clear(): void {
      this.cues = [];
      this.currentCueIndex = -1;
      if (this.subtitleContainer) {
        this.subtitleContainer.textContent = '';
      }
    }
  }

  async function initPlayer() {
    const videoElement = document.getElementById('video-player') as HTMLVideoElement;
    const loader = document.getElementById('player-loader');
    const errorState = document.getElementById('player-error');
    const episodeDataScript = document.getElementById('episode-data');
    
    if (!videoElement) return;

    // State
    const episodes = JSON.parse(episodeDataScript?.textContent || '[]');
    let currentEpisodeId = videoElement.getAttribute('data-episode-id');
    const source = videoElement.getAttribute('data-source');
    const bookId = videoElement.getAttribute('data-book-id');
    let videoUrl = videoElement.getAttribute('data-video-url');
    let currentFetchController: AbortController | null = null;
    
    // Initialize Custom Subtitle Renderer for consistent styling across all platforms
    const customSubtitleRenderer = new CustomSubtitleRenderer(videoElement);
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
    const useCustomSubtitles = isIOS || isSafari; // Use custom renderer for iOS/Safari
    
    console.log('[VideoPlayer] Using custom subtitle renderer:', useCustomSubtitles);
    
    // iOS Fake Fullscreen Setup - uses CSS fullscreen to keep subtitle overlay visible
    const videoContainer = document.getElementById('video-container');
    const iosFullscreenBtn = document.getElementById('ios-fullscreen-btn');
    const fsIconExpand = document.getElementById('fs-icon-expand');
    const fsIconCompress = document.getElementById('fs-icon-compress');
    let isIOSFullscreen = false;
    
    // Detect mobile/touch devices for custom fullscreen button
    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    
    console.log('[VideoPlayer] Mobile detection:', { isIOS, isSafari, isMobile, isTouchDevice });
    
    if ((isIOS || (isMobile && isTouchDevice)) && iosFullscreenBtn && videoContainer) {
      // Show custom fullscreen button on mobile
      iosFullscreenBtn.style.display = 'block';
      console.log('[VideoPlayer] Custom fullscreen button enabled');
      
      const toggleIOSFullscreen = () => {
        isIOSFullscreen = !isIOSFullscreen;
        
        if (isIOSFullscreen) {
          // Enter fake fullscreen
          videoContainer.classList.add('ios-fullscreen');
          document.body.style.overflow = 'hidden';
          if (fsIconExpand) fsIconExpand.style.display = 'none';
          if (fsIconCompress) fsIconCompress.style.display = 'block';
          
          // Try to lock orientation to landscape
          try {
            if ((screen.orientation as any)?.lock) {
              (screen.orientation as any).lock('landscape').catch(() => {});
            }
          } catch (e) {}
          
          console.log('[VideoPlayer] Entered fake fullscreen');
        } else {
          // Exit fake fullscreen
          videoContainer.classList.remove('ios-fullscreen');
          document.body.style.overflow = '';
          if (fsIconExpand) fsIconExpand.style.display = 'block';
          if (fsIconCompress) fsIconCompress.style.display = 'none';
          
          // Unlock orientation
          try {
            if ((screen.orientation as any)?.unlock) {
              (screen.orientation as any).unlock();
            }
          } catch (e) {}
          
          console.log('[VideoPlayer] Exited fake fullscreen');
        }
      };
      
      iosFullscreenBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggleIOSFullscreen();
      });
      
      // Handle escape key to exit fullscreen
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isIOSFullscreen) {
          toggleIOSFullscreen();
        }
      });
    }
    
    // Helper to find next episode ID
    const getNextEpisodeId = (currentId) => {
      const idx = episodes.findIndex(e => e.id === currentId);
      if (idx !== -1 && idx < episodes.length - 1) {
        return episodes[idx + 1].id;
      }
      return null;
    };

    // Log device and browser info for debugging
    console.log('[VideoPlayer] Device Info:', {
      userAgent: navigator.userAgent,
      isIOS: /iPad|iPhone|iPod/.test(navigator.userAgent),
      isSafari: /^((?!chrome|android).)*safari/i.test(navigator.userAgent),
      isAndroid: /Android/.test(navigator.userAgent),
      isChrome: /Chrome/.test(navigator.userAgent),
      canPlayHLS: videoElement.canPlayType('application/vnd.apple.mpegurl'),
      hlsJsSupported: Hls.isSupported(),
      source: source
    });

    // Helper to add subtitle tracks
    const addSubtitleTracks = () => {
      if (!window.pendingSubtitles || !Array.isArray(window.pendingSubtitles)) {
        console.log('[VideoPlayer] No pending subtitles to add');
        return;
      }

      console.log('[VideoPlayer] Adding', window.pendingSubtitles.length, 'subtitle tracks');
      
      // Find Indonesian subtitle
      const idSub = window.pendingSubtitles.find(sub => 
        sub.lang === 'id-ID' || sub.lang === 'id' || sub.label.includes('Indonesia')
      ) || window.pendingSubtitles[0];
      
      if (idSub && useCustomSubtitles) {
        // Use custom HTML renderer for iOS/Safari
        console.log('[VideoPlayer] Using Custom Subtitle Renderer:', idSub.label);
        const subUrl = (source === 'dramawave' || source === 'netshort') 
          ? '/api/proxy?url=' + encodeURIComponent(idSub.url) 
          : idSub.url;
        customSubtitleRenderer.loadFromUrl(subUrl);
      } else {
        // Use native tracks for other platforms
        const oldTracks = videoElement.querySelectorAll('track');
        oldTracks.forEach(t => t.remove());

        let defaultSet = false;
        window.pendingSubtitles.forEach(sub => {
          const track = document.createElement('track');
          track.kind = 'subtitles';
          track.label = sub.label;
          track.srclang = sub.lang;
          track.src = (source === 'dramawave') ? '/api/proxy?url=' + encodeURIComponent(sub.url) : sub.url;
          
          if (!defaultSet && (sub.lang === 'id-ID' || sub.lang === 'id' || sub.label.includes('Indonesia'))) {
            track.default = true;
            defaultSet = true;
            console.log('[VideoPlayer] Auto-selecting External Subtitle:', sub.label);
          }
          videoElement.appendChild(track);
          
          if (track.default) {
            track.mode = 'showing';
          }
        });
      }
      
      // Clear pending subtitles
      window.pendingSubtitles = null;
    };


    // Load and Play Video Logic
    const loadAndPlay = async (urlPayload, isAutoNext = false) => {
       let url = urlPayload;
       // Parse JSON payload if sent (containing subtitles or error)
       if (typeof urlPayload === 'string' && urlPayload.trim().startsWith('{')) {
           try {
               const data = JSON.parse(urlPayload);
               
               // Check if this is a web player redirect
               if (data.error === 'webplayer') {
                   console.log('[VideoPlayer] Redirecting to web player:', data.redirectUrl);
                   if (loader) loader.style.display = 'none';
                   if (errorState) {
                       errorState.querySelector('h3').textContent = '🌐 Buka di Web Player';
                       errorState.querySelector('p').textContent = data.message || 'Drama ini hanya tersedia di FlickReels Web Player';
                       const btn = errorState.querySelector('button');
                       btn.textContent = 'Buka FlickReels';
                       btn.onclick = () => window.open(data.redirectUrl, '_blank');
                       errorState.classList.remove('hidden');
                   }
                   return;
               }
               
               // Check if this is a premium/locked episode error
               if (data.error === 'premium') {
                   console.error('[VideoPlayer] Premium episode:', data.message);
                   if (loader) loader.style.display = 'none';
                   if (errorState) {
                       errorState.querySelector('h3').textContent = '🔒 Episode Premium';
                       errorState.querySelector('p').textContent = data.message || 'Episode ini memerlukan akun premium';
                       errorState.classList.remove('hidden');
                   }
                   return; // Stop loading
               }
               
               url = data.videoUrl;
               // Wait for player to be ready before adding tracks? No, HLS needs init first.
               // We'll set a global/scoped variable to add them after attach
               window.pendingSubtitles = data.subtitles; 
           } catch(e) {
               console.error('[VideoPlayer] Failed to parse payload:', e);
           }
       }

       // --- PROXY LOGIC FOR DRAMAWAVE & FLICKREELS ---
       if (
           (source === 'dramawave' && url.includes('mydramawave.com') && !url.includes('/api/proxy')) ||
           (source === 'dramaflickreels' && url.includes('farsunpteltd.com') && !url.includes('/api/proxy')) ||
           (source === 'dramabox' && !url.includes('/api/proxy'))
       ) {
           url = '/api/proxy?url=' + encodeURIComponent(url);
           console.log('[VideoPlayer] Using Proxy:', url);
       }
       // ---------------------------------

       console.log(`[VideoPlayer] Loading: ${url}`);
       const decodedUrl = decodeURIComponent(url);
       const isHLS = (decodedUrl.includes('.m3u8') || decodedUrl.includes('playlist.m3u8')) && !decodedUrl.includes('.mp4');

       if (loader) {
         loader.style.display = 'flex';
         loader.style.opacity = '1';
       }

       const onReady = () => {
         videoElement.classList.remove('opacity-0');
         if (loader) {
           loader.style.opacity = '0';
           setTimeout(() => loader.style.display = 'none', 500);
         }
         videoElement.play().catch(e => console.log('Autoplay blocked:', e));
       };

       if (isHLS) {
          // Detect iOS/Safari for native HLS support
          const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
          const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
          const useNativeHLS = isIOS || isSafari || videoElement.canPlayType('application/vnd.apple.mpegurl');
          
          if (useNativeHLS && videoElement.canPlayType('application/vnd.apple.mpegurl')) {
             // Native HLS support (Safari iOS/macOS, some Android browsers)
             console.log('[VideoPlayer] Using Native HLS Player');
             videoElement.src = url;
             
             // Add external subtitles for native player
             if (window.pendingSubtitles && Array.isArray(window.pendingSubtitles)) {
               // Find Indonesian subtitle
               const idSub = window.pendingSubtitles.find(sub => 
                 sub.lang === 'id-ID' || sub.lang === 'id' || sub.label.includes('Indonesia')
               ) || window.pendingSubtitles[0];
               
               if (idSub) {
                 // Use custom HTML renderer for iOS/Safari for consistent styling
                 if (useCustomSubtitles) {
                   console.log('[VideoPlayer] Using Custom Subtitle Renderer (iOS/Safari):', idSub.label);
                   const subUrl = (source === 'dramawave' || source === 'netshort') 
                     ? '/api/proxy?url=' + encodeURIComponent(idSub.url) 
                     : idSub.url;
                   customSubtitleRenderer.loadFromUrl(subUrl);
                 } else {
                   // Fallback to native tracks for non-iOS/Safari
                   const oldTracks = videoElement.querySelectorAll('track');
                   oldTracks.forEach(t => t.remove());
                   
                   window.pendingSubtitles.forEach(sub => {
                     const track = document.createElement('track');
                     track.kind = 'subtitles';
                     track.label = sub.label;
                     track.srclang = sub.lang;
                     track.src = (source === 'dramawave' || source === 'netshort') ? '/api/proxy?url=' + encodeURIComponent(sub.url) : sub.url;
                     
                     if (sub === idSub) {
                       track.default = true;
                       track.mode = 'showing';
                       console.log('[VideoPlayer] Auto-selecting External Subtitle (Native):', sub.label);
                     }
                     videoElement.appendChild(track);
                   });
                 }
               }
               
               window.pendingSubtitles = null;
             }
             
             videoElement.onloadedmetadata = onReady;
             
          } else if (Hls.isSupported()) {
            // HLS.js for browsers without native HLS support (mostly Android Chrome)
            console.log('[VideoPlayer] Using HLS.js Player');
            
            // Destroy previous HLS instance if exists
            if (window.hlsInstance) {
               window.hlsInstance.destroy();
            }
            
            // SIMPLIFIED HLS CONFIG for better mobile compatibility
            const hlsConfig = {
              // Core settings
              enableWorker: true,
              lowLatencyMode: false,
              
              // Buffer settings - more conservative for mobile
              maxBufferLength: 15,        // Reduced from 20
              maxMaxBufferLength: 30,     // Reduced from 40
              maxBufferSize: 20 * 1000 * 1000, // 20 MB (reduced from 30)
              maxBufferHole: 0.5,
              
              // Loading timeouts - more lenient for slower connections
              manifestLoadingTimeOut: 15000,  // Increased from 10s
              manifestLoadingMaxRetry: 4,     // Increased retries
              manifestLoadingRetryDelay: 1000, // Increased delay
              levelLoadingTimeOut: 15000,
              levelLoadingMaxRetry: 4,
              fragLoadingTimeOut: 30000,      // Increased from 20s
              fragLoadingMaxRetry: 6,         // More retries for mobile
              
              // Adaptive Bitrate - start with lower quality on mobile
              startLevel: -1,
              capLevelToPlayerSize: true,
              
              // Network - more conservative for mobile
              abrEwmaDefaultEstimate: 500000,
              abrBandWidthFactor: 0.95,      // Increased from 0.8
              abrBandWidthUpFactor: 0.7,
              
              // Fragment Loading
              backBufferLength: 10,
              
              // XHR setup for better mobile compatibility
              xhrSetup: function(xhr, url) {
                // Ensure proper headers for mobile
                xhr.withCredentials = false;
              },
              
              // Debug
              debug: false
            };
            
            const hls = new Hls(hlsConfig);
            window.hlsInstance = hls;
            
            hls.loadSource(url);
            hls.attachMedia(videoElement);
            hls.on(Hls.Events.MANIFEST_PARSED, (event, data) => {
              console.log('[VideoPlayer] HLS Manifest parsed, levels:', data.levels.length);
              
              // Auto-select Indonesian Audio if available
              if (hls.audioTracks && hls.audioTracks.length > 0) {
                const idTrack = hls.audioTracks.findIndex(t => 
                  (t.lang && (t.lang.toLowerCase() === 'id' || t.lang.toLowerCase().includes('indo'))) || 
                  (t.name && t.name.toLowerCase().includes('indo'))
                );
                if (idTrack !== -1) {
                  console.log('[VideoPlayer] Auto-selecting Audio:', hls.audioTracks[idTrack].name);
                  hls.audioTrack = idTrack;
                }
              }
              
              // Add external subtitles
              if (window.pendingSubtitles && Array.isArray(window.pendingSubtitles)) {
                  const oldTracks = videoElement.querySelectorAll('track');
                  oldTracks.forEach(t => t.remove());

                  let defaultSet = false;
                  window.pendingSubtitles.forEach(sub => {
                      const track = document.createElement('track');
                      track.kind = 'subtitles';
                      track.label = sub.label;
                      track.srclang = sub.lang;
                      track.src = (source === 'dramawave' || source === 'netshort') ? '/api/proxy?url=' + encodeURIComponent(sub.url) : sub.url;
                      
                      if (!defaultSet && (sub.lang === 'id-ID' || sub.lang === 'id' || sub.label.includes('Indonesia'))) {
                          track.default = true;
                          defaultSet = true;
                          console.log('[VideoPlayer] Auto-selecting External Subtitle:', sub.label);
                      }
                      videoElement.appendChild(track);
                      
                      if (track.default) {
                         track.mode = 'showing';
                      }
                  });
                  
                  window.pendingSubtitles = null;
              }

              // Auto-select Indonesian Subtitle if available in HLS
              if (hls.subtitleTracks && hls.subtitleTracks.length > 0) {
                 const idSub = hls.subtitleTracks.findIndex(t => 
                   (t.lang && (t.lang.toLowerCase() === 'id' || t.lang.toLowerCase().includes('indo'))) || 
                   (t.name && t.name.toLowerCase().includes('indo'))
                 );
                 if (idSub !== -1) {
                   console.log('[VideoPlayer] Auto-selecting HLS Subtitle:', hls.subtitleTracks[idSub].name);
                   hls.subtitleTrack = idSub;
                 }
              }
              
              onReady();
            });
            
            // Enhanced error handling for mobile
            hls.on(Hls.Events.ERROR, (event, data) => {
              console.log('[VideoPlayer] HLS Error:', data.type, data.details, data.fatal);
              
              if (data.fatal) {
                switch(data.type) {
                  case Hls.ErrorTypes.NETWORK_ERROR:
                    console.log('[VideoPlayer] Network error, attempting recovery...');
                    setTimeout(() => hls.startLoad(), 1000);
                    break;
                  case Hls.ErrorTypes.MEDIA_ERROR:
                    console.log('[VideoPlayer] Media error, attempting recovery...');
                    hls.recoverMediaError();
                    break;
                  default:
                    console.error('[VideoPlayer] Unrecoverable error, trying native fallback...');
                    // Try native playback as fallback
                    if (videoElement.canPlayType('application/vnd.apple.mpegurl')) {
                      console.log('[VideoPlayer] Falling back to native HLS');
                      hls.destroy();
                      videoElement.src = url;
                      videoElement.load();
                      videoElement.onloadedmetadata = onReady;
                    } else {
                      if (errorState) errorState.classList.remove('hidden');
                    }
                    break;
                }
              }
            });
            
          } else {
            // No HLS support at all - show error
            console.error('[VideoPlayer] No HLS support available');
            if (loader) loader.style.display = 'none';
            if (errorState) {
              errorState.querySelector('h3').textContent = 'Browser Tidak Didukung';
              errorState.querySelector('p').textContent = 'Browser Anda tidak mendukung pemutaran video HLS. Silakan gunakan browser modern seperti Chrome atau Safari.';
              errorState.classList.remove('hidden');
            }
          }
       } else {
         // Non-HLS video (MP4, e.g., NetShort)
         videoElement.src = url;
         addSubtitleTracks(); // Add subtitle tracks for non-HLS videos
         videoElement.load();
         videoElement.onloadeddata = onReady;
       }
    };

    // Handle Auto Play Next Episode
    videoElement.onended = async () => {
      const nextId = getNextEpisodeId(currentEpisodeId);
      
      if (nextId) {
        console.log('[VideoPlayer] Video ended. Next episode:', nextId);
        
        // CHECK FULLSCREEN STATUS
        // iOS Safari uses webkitDisplayingFullscreen
        const isFullscreen = document.fullscreenElement || (videoElement as any).webkitDisplayingFullscreen;
        
        if (isFullscreen) {
           console.log('[VideoPlayer] In Fullscreen. Seamless transition...');
           
           // Abort previous pending requests if any
           if (currentFetchController) {
               currentFetchController.abort();
           }
           currentFetchController = new AbortController();

           // 1. Fetch next video URL
           try {
             // Show loader inside fullscreen
             if (loader) {
                loader.style.display = 'flex';
                loader.style.opacity = '1';
             }
             
             const res = await fetch(`/api/video-stream?source=${source}&bookId=${bookId}&episodeId=${nextId}`, {
                 signal: currentFetchController.signal
             });
             const data = await res.json();
             
             if (data.videoUrl) {
                // 2. Play next video
                await loadAndPlay(data.videoUrl, true);
                
                // 3. Update State & URL
                currentEpisodeId = nextId;
                const newUrl = `/watch/${source}/${bookId}/${nextId}`;
                window.history.pushState({ path: newUrl }, '', newUrl);
                
                // 4. Mark that we drifted from initial page
                videoElement.setAttribute('data-drifted', 'true');
             }
           } catch (e: any) {
             if (e.name === 'AbortError') {
                 console.log('[VideoPlayer] Fetch aborted');
                 return;
             }
             console.error('Failed seamless next:', e);
             // Fallback to normal navigation
             window.location.href = `/watch/${source}/${bookId}/${nextId}`;
           } finally {
             currentFetchController = null;
           }
        } else {
           // Normal Navigation
           window.location.href = `/watch/${source}/${bookId}/${nextId}`;
        }
      }
    };
    
    // Listener for exiting fullscreen -> Reload to sync UI if we drifted
    // Listener for exiting fullscreen -> Reload to sync UI if we drifted
    const onFullscreenExit = () => {
       const isFullscreen = document.fullscreenElement || (videoElement as any).webkitDisplayingFullscreen;
       if (!isFullscreen && videoElement.getAttribute('data-drifted') === 'true') {
         console.log('[VideoPlayer] Exited fullscreen after seamless play. Reloading UI...');
         window.location.reload();
       }
    };

    document.addEventListener('fullscreenchange', onFullscreenExit);
    videoElement.addEventListener('webkitendfullscreen', onFullscreenExit); // iOS specific

    // Initial Load
    if (!videoUrl && source && bookId && currentEpisodeId) {
      try {
        const response = await fetch(`/api/video-stream?source=${source}&bookId=${bookId}&episodeId=${currentEpisodeId}`);
        const data = await response.json();
        const payload = data.videoUrl; // Can be JSON string

        loadAndPlay(payload);
        return; // loadAndPlay handles parsing
      } catch (e) {
        console.error('[VideoPlayer] Client-side fetch failed:', e);
      }
    }

    if (videoUrl) {
      // Check if videoUrl needs parsing (passed via props)
      loadAndPlay(videoUrl);
    } else {
      if (loader) loader.style.display = 'none';
      if (errorState) errorState.classList.remove('hidden');
    }
  }

  // Initialize on load and on Astro view transitions
  initPlayer();
  document.addEventListener('astro:page-load', initPlayer);
</script>
