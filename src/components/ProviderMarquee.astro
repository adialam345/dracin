---
const providers = [
  { name: "DramaBox", code: "DB", color: "bg-red-600" },
  { name: "NetShort", code: "NS", color: "bg-blue-600" },
  { name: "RadReel", code: "RR", color: "bg-purple-600" },
  { name: "ShortMax", code: "SM", color: "bg-yellow-500" },
  { name: "StarShort", code: "SS", color: "bg-emerald-600" },
  { name: "DramaWave", code: "DW", color: "bg-orange-500" },
  { name: "Melolo", code: "ML", color: "bg-lime-600" },
  { name: "FlickReels", code: "FR", color: "bg-pink-600" },
  { name: "GoodShort", code: "GS", color: "bg-teal-500" },
  { name: "HiShort", code: "HS", color: "bg-fuchsia-600" },
  { name: "FreeShort", code: "FS", color: "bg-indigo-600" },
  { name: "StardustTV", code: "SD", color: "bg-sky-500" },
  { name: "DotDrama", code: "DTD", color: "bg-rose-600" },
  { name: "DramaDash", code: "DD", color: "bg-cyan-600" },
  { name: "ReelLife", code: "RL", color: "bg-orange-600" },
  { name: "Meloshort", code: "MS", color: "bg-rose-500" }
];

// Double the array for seamless infinite scroll
const marqueeItems = [...providers, ...providers];
---

<div class="relative w-full overflow-hidden select-none">
    {/* Gradient fade edges */}
    <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-zinc-950 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-zinc-950 to-transparent z-10 pointer-events-none"></div>

    {/* Scrolling container */}
    <div class="flex items-center animate-scroll gap-4 py-2">
        {marqueeItems.map((provider) => (
            <div class="flex-shrink-0 flex items-center gap-3 pl-2 pr-4 py-1.5 rounded-full bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 backdrop-blur-sm transition-all duration-300 hover:scale-105 group cursor-default">
                <span class={`flex items-center justify-center w-7 h-5 rounded text-[10px] font-bold text-white shadow-sm ${provider.color}`}>
                    {provider.code}
                </span>
                <span class="text-sm font-medium text-zinc-400 group-hover:text-white whitespace-nowrap transition-colors">
                    {provider.name}
                </span>
            </div>
        ))}
    </div>
</div>

<style>
    @keyframes scroll {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
    
    .animate-scroll {
        animation: scroll 40s linear infinite;
        width: fit-content;
    }
    
    .animate-scroll:hover {
        animation-play-state: paused;
    }
</style>
