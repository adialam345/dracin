---
interface Props {
  count?: number;
}

const { count = 6 } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-6 gap-y-10">
  {Array.from({ length: count }).map((_, i) => (
    <div class="skeleton-card" style={`animation-delay: ${i * 100}ms`}>
      <div class="relative overflow-hidden rounded-2xl aspect-[2/3] skeleton">
        {/* Badge skeleton overlay */}
        <div class="absolute top-2 right-2 w-8 h-4 rounded-sm bg-white/5 z-10"></div>
        
        {/* Text content skeleton overlay */}
        <div class="absolute bottom-0 left-0 right-0 p-5 space-y-2 z-10">
          <div class="h-4 w-3/4 rounded bg-white/5"></div>
          <div class="h-3 w-1/2 rounded bg-white/5"></div>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .skeleton-card {
    animation: skeletonFadeIn 0.5s ease-out forwards;
    opacity: 0;
  }

  @keyframes skeletonFadeIn {
    to {
      opacity: 1;
    }
  }
</style>
