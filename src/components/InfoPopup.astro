---
interface Props {
  latestUpdate: {
    id: number;
    title: string;
    content: string;
    tag: string;
    color: string;
    date: string;
  } | null;
}

const { latestUpdate } = Astro.props;
---

{latestUpdate && (
  <div id="info-popup" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300" data-update-id={latestUpdate.id}>
    <div class="relative w-full max-w-md bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl transform scale-95 transition-all duration-300" id="info-popup-content">
      
      <!-- Decorator -->
      <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-20 h-20 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-full blur-[40px] opacity-50 pointer-events-none"></div>

      <!-- Close Button -->
      <button id="close-popup" aria-label="Tutup" class="absolute top-4 right-4 text-zinc-400 hover:text-white transition-colors p-1 bg-black/30 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <!-- Content -->
      <div class="p-6 pt-5 text-center">
        <!-- Icon -->
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-800 border border-zinc-700 shadow-inner mb-4 relative overflow-hidden group">
           <div class="absolute inset-0 bg-indigo-500/20 blur-xl group-hover:bg-indigo-500/30 transition-all"></div>
           <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-400 relative z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
            <path d="M12 8h.01"/>
            <path d="M11 12h1v4h1"/>
          </svg>
        </div>

        <!-- Tag -->
        <div class="mb-3">
          {(() => {
            const tag = latestUpdate.tag || 'Info';
            const colors = {
              'Info': 'bg-blue-500/20 text-blue-400 border-blue-500/30',
              'Fitur': 'bg-purple-500/20 text-purple-400 border-purple-500/30',
              'Fix': 'bg-green-500/20 text-green-400 border-green-500/30',
              'Penting': 'bg-red-500/20 text-red-400 border-red-500/30'
            };
            const colorClass = colors[tag] || colors['Info'];
            
            return (
              <span class={`text-[10px] font-bold px-2.5 py-1 rounded-full border border-opacity-20 uppercase tracking-wide ${colorClass}`}>
                {tag}
              </span>
            );
          })()}
        </div>

        <h3 class="text-xl font-bold text-white mb-2">{latestUpdate.title}</h3>
        <p class="text-sm text-zinc-400 leading-relaxed mb-6">
          {latestUpdate.content}
        </p>

        <a href="/info" class="block w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold text-sm transition-all shadow-lg shadow-indigo-500/20 mb-3 tracking-wide">
          Lihat Semua Info
        </a>
        
        <button id="dismiss-popup" class="text-xs text-zinc-400 hover:text-zinc-300 transition-colors">
            Tutup & Jangan Tampilkan Lagi
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ updateId: latestUpdate.id }}>
    // Run this logic on the client
    document.addEventListener('astro:page-load', () => {
        checkPopup();
    });
    
    // Also run on initial load (if ViewTransitions not triggering immediately or handled normally)
    checkPopup();

    function checkPopup() {
        const popup = document.getElementById('info-popup');
        const content = document.getElementById('info-popup-content');
        const closeBtn = document.getElementById('close-popup');
        const dismissBtn = document.getElementById('dismiss-popup');
        
        if (!popup) return;

        const seenId = localStorage.getItem('last_seen_update');
        
        // Show if explicitly NOT seen
        if (seenId != updateId) {
            // Check if user has dismissed it THIS session? No, persist forever until new update.
            setTimeout(() => {
                popup.classList.remove('hidden');
                // Trigger reflow
                void popup.offsetWidth; 
                popup.classList.remove('opacity-0');
                if(content) content.classList.remove('scale-95');
            }, 1000); // Delay slightly for effect
        }

        const close = () => {
            popup.classList.add('opacity-0');
            if(content) content.classList.add('scale-95');
            setTimeout(() => {
                popup.classList.add('hidden');
            }, 300);
            
            // Save as seen
            localStorage.setItem('last_seen_update', updateId);
        };

        if(closeBtn) closeBtn.onclick = close;
        if(dismissBtn) dismissBtn.onclick = close;
        
        // Close on backdrop click
        popup.onclick = (e) => {
            if (e.target === popup) close();
        };
    }
  </script>
)}
